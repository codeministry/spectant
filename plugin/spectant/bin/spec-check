function help() {
  const width = Math.max(...Object.keys(COMMANDS).map((n) => n.length));
  return [
    "spec-check <command> [args] [--json]",
    "",
    ...Object.entries(COMMANDS).map(([name, c]) => `  ${name.padEnd(width)}  ${c.summary}`),
    "",
    "spec-check <command> --help shows one command. Exit: 0 ok, 1 bad arguments, 3 drift or gate open, 4 lock lost."
  ].join(`
`);
}
async function main(argv, cwd = process.cwd(), now = new Date) {
  const out = (text2) => process.stdout.write(`${text2}
`);
  const fail = (code, message) => {
    process.stderr.write(`spec-check: ${message}
`);
    return code;
  };
  const [name, ...rest] = argv;
  if (name === undefined || name === "--help" || name === "-h" || name === "help") {
    out(help());
    return name === undefined ? EXIT.badArgs : EXIT.ok;
  }
  const command = COMMANDS[name];
  if (command === undefined)
    return fail(EXIT.badArgs, `unknown command "${name}"

${help()}`);
  if (rest.includes("--help") || rest.includes("-h")) {
    out(`spec-check ${command.usage}

${command.summary}`);
    return EXIT.ok;
  }
  try {
    const args = parseArgs(rest, command.values ?? [], command.flags ?? []);
    return await command.run({ cwd, root: repoRoot(cwd), now, out }, args);
  } catch (error) {
    if (error instanceof CliError)
      return fail(error.exit, `${name}: ${error.message}`);
    if (error instanceof SpecTextError)
      return fail(EXIT.badArgs, `${name}: ${error.message} (${error.code}); nothing written`);
    if (error instanceof ActivityTextError)
      return fail(EXIT.badArgs, `${name}: ${error.message} (${error.code}); nothing written`);
    if (error instanceof ActivityLogError)
      return fail(EXIT.badArgs, `${name}: ${error.message} (${error.code}); pass --claim ISC-N`);
    throw error;
  }
}
if (import.meta.main)
  process.exit(await main(process.argv.slice(2)));
export {
  main,
  EXIT
};
