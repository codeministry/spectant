function joinPath(base, rel) {
  const absolute = base.startsWith("/");
  const out = [];
  for (const segment of `${base}/${rel}`.split("/")) {
    if (segment === "" || segment === ".")
      continue;
    if (segment === ".." && out.length > 0 && out[out.length - 1] !== "..")
      out.pop();
    else if (segment !== ".." || !absolute)
      out.push(segment);
  }
  return (absolute ? "/" : "") + out.join("/");
}
function specFilePath(specDir, kind) {
  return joinPath(specDir, FILE_KINDS[kind].path);
}

// core/src/gates.ts
import { createHash as createHash2 } from "crypto";
var REVIEWED_FILES = ["spec.md", "plan.md", "tasks.md"];
var OBJECT_ID = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/;
var SHA256_HEX = /^[0-9a-f]{64}$/;
var FEATURE_ID = /^F[0-9]+$/;
function isRecord2(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}
var stringOrNull = (value) => typeof value === "string" ? value : null;
var count = (value) => typeof value === "number" && Number.isInteger(value) && value >= 0 ? value : null;
function readGateMark(gate, text) {
  const diagnostics = [];
  const fail = (code2, message) => ({ mark: null, diagnostics: [...diagnostics, { severity: "error", code: code2, message }] });
  const warn = (code2, message) => diagnostics.push({ severity: "warning", code: code2, message });
  let data;
  try {
    data = JSON.parse(text);
  } catch (error) {
    return fail("gate-json-invalid", `The ${gate} mark is not valid JSON: ${error instanceof Error ? error.message : "parse error"}.`);
  }
  if (!isRecord2(data))
    return fail("gate-not-object", `The ${gate} mark is not a JSON object.`);
  if (data.gate === undefined)
    warn("gate-name-missing", `The mark names no gate; read as ${gate} from its file name.`);
  else if (data.gate !== gate)
    return fail("gate-mismatch", `The mark names gate ${JSON.stringify(data.gate)}, expected ${gate}.`);
  let at = "";
  if (typeof data.at === "string" && data.at !== "")
    at = data.at;
  else
    warn("gate-at-missing", `The ${gate} mark carries no time.`);
  if (gate === "reviewed") {
    if (!isRecord2(data.files))
      return fail("gate-files-missing", "The reviewed mark holds no files object.");
    const files = {};
    for (const f of REVIEWED_FILES) {
      const value = data.files[f] ?? null;
      if (value === null)
        files[f] = null;
      else if (typeof value === "string" && SHA256_HEX.test(value))
        files[f] = value;
      else {
        warn("gate-file-hash-invalid", `The reviewed mark's hash for ${f} is not a sha256 hex; it can never match.`);
        files[f] = typeof value === "string" ? value : "";
      }
    }
    return { mark: { gate, at, files }, diagnostics };
  }
  if (typeof data.tree !== "string")
    return fail("gate-tree-missing", "The code-reviewed mark holds no tree id.");
  if (!OBJECT_ID.test(data.tree))
    return fail("gate-tree-invalid", `The code-reviewed mark's tree ${JSON.stringify(data.tree)} is not a git object id.`);
  const source = isRecord2(data.findings) ? data.findings : data;
  const code = count(source.code);
  const security = count(source.security);
  let findings = null;
  if (code !== null || security !== null)
    findings = { code: code ?? 0, security: security ?? 0 };
  else if (data.findings !== undefined)
    warn("gate-findings-invalid", "The code-reviewed mark holds findings without code or security counts.");
  let scope = null;
  if (typeof data.scope === "string" && FEATURE_ID.test(data.scope))
    scope = data.scope;
  else if (data.scope !== undefined) {
    warn("gate-scope-invalid", `The code-reviewed mark's scope ${JSON.stringify(data.scope)} is not a feature id F<n>; it is read as a per-spec mark.`);
  }
  return {
    mark: {
      gate,
      at,
      root: stringOrNull(data.root),
      tree: data.tree,
      head: stringOrNull(data.head),
      branch: stringOrNull(data.branch),
      findings,
      note: stringOrNull(data.note),
      scope
    },
    diagnostics
  };
}
function gateState(gate, mark, current) {
  if (mark?.gate !== gate)
    return { gate, state: "missing", at: null, changed: [] };
  const at = mark.at === "" ? null : mark.at;
  if (mark.gate === "reviewed") {
    const texts = current.texts ?? {};
    const changed = REVIEWED_FILES.filter((f) => {
      const text = texts[f];
      return mark.files[f] !== (text === undefined ? null : hashForGate(f, text));
    });
    return { gate, state: changed.length ? "stale" : "fresh", at, changed };
  }
  const tree = current.worktreeTree ?? null;
  if (tree === null)
    return { gate, state: "stale", at, changed: [], detail: "worktree tree id unavailable" };
  return { gate, state: tree === mark.tree ? "fresh" : "stale", at, changed: [] };
}
function reviewedGate(texts) {
  const reading = texts.gateReviewed === undefined ? null : readGateMark("reviewed", texts.gateReviewed);
  const current = {};
  if (texts.spec !== undefined)
    current["spec.md"] = texts.spec;
  if (texts.plan !== undefined)
    current["plan.md"] = texts.plan;
  if (texts.tasks !== undefined)
    current["tasks.md"] = texts.tasks;
  return { reading, check: gateState("reviewed", reading?.mark ?? null, { texts: current }) };
}
function reviewedMarkText(at, files) {
  if (at === "")
    throw new RangeError("reviewedMarkText: the mark needs a time");
  const ordered = {};
  for (const f of REVIEWED_FILES) {
    const hash = files[f];
    if (hash !== null && !SHA256_HEX.test(hash))
      throw new RangeError(`reviewedMarkText: the hash of ${f} ${JSON.stringify(hash)} is not a sha256 hex`);
    ordered[f] = hash;
  }
  return `${JSON.stringify({ gate: "reviewed", at, files: ordered }, null, 2)}
`;
}
function codeReviewedMarkText(fields) {
  if (!OBJECT_ID.test(fields.tree))
    throw new RangeError(`codeReviewedMarkText: tree ${JSON.stringify(fields.tree)} is not a git object id`);
  if (fields.scope !== undefined && !FEATURE_ID.test(fields.scope))
    throw new RangeError(`codeReviewedMarkText: scope ${JSON.stringify(fields.scope)} is not F<n>`);
  if (count(fields.code) === null || count(fields.security) === null)
    throw new RangeError("codeReviewedMarkText: code and security must be non-negative integers");
  const mark = { gate: "code-reviewed", at: fields.at };
  if (fields.actor !== undefined)
    mark.actor = fields.actor;
  if (fields.scope !== undefined)
    mark.scope = fields.scope;
  mark.tree = fields.tree;
  if (typeof fields.head === "string")
    mark.head = fields.head;
  if (typeof fields.branch === "string")
    mark.branch = fields.branch;
  mark.code = fields.code;
  mark.security = fields.security;
  if (typeof fields.note === "string")
    mark.note = fields.note;
  return `${JSON.stringify(mark, null, 2)}
`;
}
function normalizeForGate(file, text) {
  let s = text.replace(/\r\n?/g, `
`).replace(/^---\n[\s\S]*?\n---\n?/, "");
  s = s.replace(/^(\s*- )\[[ xX]\]/gm, "$1[ ]");
  if (file === "tasks.md")
    s = s.replace(/~~/g, "");
  if (file === "spec.md") {
    for (const heading of ["Not yet specified", "Decisions", "Verification"]) {
      s = s.replace(new RegExp(`^## ${heading}\\b[^\\n]*\\n[\\s\\S]*?(?=^## |(?![\\s\\S]))`, "m"), "");
    }
  }
  return s.split(`
`).map((line) => line.trimEnd()).join(`
`).trim();
}
function hashForGate(file, text) {
  return createHash2("sha256").update(normalizeForGate(file, text)).digest("hex");
}
var MODES = new Set(["100644", "100755", "120000"]);
var newDir = () => ({ files: new Map, dirs: new Map });
var encoder = new TextEncoder;
function objectId(type, body) {
  return createHash2("sha1").update(`${type} ${body.length}\x00`).update(body).digest();
}
function treeObjectId(dir) {
  const entries = [];
  for (const [name, file] of dir.files) {
    entries.push({ key: encoder.encode(name), head: encoder.encode(`${file.mode} ${name}\x00`), id: objectId("blob", file.bytes) });
  }
  for (const [name, sub] of dir.dirs) {
    entries.push({ key: encoder.encode(`${name}/`), head: encoder.encode(`40000 ${name}\x00`), id: treeObjectId(sub) });
  }
  entries.sort((x, y) => Buffer.compare(x.key, y.key));
  return objectId("tree", Buffer.concat(entries.flatMap((e) => [e.head, e.id])));
}
function treeIdOf(entries) {
  const root = newDir();
  for (const entry of entries) {
    if (!MODES.has(entry.mode))
      throw new RangeError(`treeIdOf: unsupported mode ${entry.mode} for ${entry.path}`);
    const segments = entry.path.split("/");
    if (segments.some((s) => s === "" || s === "." || s === ".." || s.includes("\x00"))) {
      throw new RangeError(`treeIdOf: invalid path ${JSON.stringify(entry.path)}`);
    }
    const name = segments.pop() ?? "";
    let dir = root;
    for (const segment of segments) {
      if (dir.files.has(segment))
        throw new RangeError(`treeIdOf: ${entry.path} lies under a file`);
      let sub = dir.dirs.get(segment);
      if (!sub) {
        sub = newDir();
        dir.dirs.set(segment, sub);
      }
      dir = sub;
    }
    if (dir.files.has(name) || dir.dirs.has(name))
      throw new RangeError(`treeIdOf: duplicate path ${entry.path}`);
    dir.files.set(name, { mode: entry.mode, bytes: entry.bytes });
  }
  return treeObjectId(root).toString("hex");
}

// core/src/markdown.ts
var TARGET = String.raw`((?:[^()\s]|\([^()\s]*\))+)`;
var IMAGE_INLINE = new RegExp(String.raw`!\[([^\]\n]*)\]\(${TARGET}\)`, "g");
var LINK_INLINE = new RegExp(String.raw`\[([^\]\n]+)\]\(${TARGET}\)`, "g");
var IMAGE_LINE = new RegExp(String.raw`^!\[([^\]\n]*)\]\(${TARGET}\)$`);
var TABLE_SEP = /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/;
function tableCells2(line) {
  return line.trim().replace(/^\|/, "").replace(/\|$/, "").split(/(?<!\\)\|/).map((c) => c.trim().replace(/\\\|/g, "|"));
}

// core/src/ideas.ts
var IDEAS_DIR = "specs/ideas/";
var INDEX = "README.md";
var STORY_FILE = /^([^/\\.][^/\\]*)\.md$/;
var warning2 = (code, message, subject) => ({ severity: "warning", code, message, subject });
function keyValue(value) {
  const v = value?.trim();
  return v === undefined || v === "" ? null : v;
}
function goalLine(body) {
  const lines = body.split(`
`);
  const start = lines.findIndex((line) => /^##\s+Goal\b/.test(line));
  if (start < 0)
    return null;
  let comment = false;
  for (const raw of lines.slice(start + 1)) {
    let line = raw.trim();
    if (comment) {
      const end = line.indexOf("-->");
      if (end < 0)
        continue;
      comment = false;
      line = line.slice(end + 3).trim();
    }
    if (/^#{1,6}\s/.test(line))
      return null;
    while (line.startsWith("<!--")) {
      const end = line.indexOf("-->");
      if (end < 0) {
        comment = true;
        line = "";
        break;
      }
      line = line.slice(end + 3).trim();
    }
    if (line !== "")
      return line;
  }
  return null;
}
function plainName(cell) {
  return cell.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1").replace(/`/g, "").trim().replace(/\.md$/, "");
}
var started = (cell) => !/^[\s\u2014\u2013-]*$/.test(plainName(cell ?? ""));
function indexRows(text) {
  const lines = text.replace(/\r\n?/g, `
`).split(`
`);
  const rows = [];
  let fenced = false;
  for (let i = 0;i < lines.length; i++) {
    const line = lines[i] ?? "";
    if (/^\s*(```|~~~)/.test(line))
      fenced = !fenced;
    if (fenced || !/^\s*\|/.test(line) || !TABLE_SEP.test(lines[i + 1] ?? ""))
      continue;
    const header = tableCells2(line).map((c) => plainName(c).toLowerCase());
    if (header[0] !== "story")
      continue;
    const spec = header.indexOf("spec");
    for (i += 2;i < lines.length && /^\s*\|/.test(lines[i] ?? ""); i++) {
      const cells = tableCells2(lines[i] ?? "");
      const name = plainName(cells[0] ?? "");
      if (name !== "")
        rows.push({ name, started: spec >= 0 && started(cells[spec]) });
    }
    i -= 1;
  }
  return rows;
}
function checkIndex(index, slugs) {
  const rows = index === undefined ? [] : indexRows(index);
  const named = new Set(rows.map((r) => r.name));
  const present = new Set(slugs);
  const file = `${IDEAS_DIR}${INDEX}`;
  return [
    ...slugs.filter((slug) => !named.has(slug)).map((slug) => ({ file, diagnostic: warning2("ideas-index", `The story ${slug} is not named in the index ${INDEX}.`, slug) })),
    ...[...new Set(rows.filter((r) => !r.started && !present.has(r.name)).map((r) => r.name))].map((name) => ({
      file,
      diagnostic: warning2("ideas-index", `The index names ${name}, but ${IDEAS_DIR}${name}.md is not a story file.`, name)
    }))
  ];
}
function readIdeas(files) {
  const ideas = [];
  const diagnostics = [];
  const names2 = Object.keys(files).filter((name) => name !== INDEX && STORY_FILE.test(name)).sort();
  for (const name of names2) {
    const slug = name.slice(0, -".md".length);
    const path = `${IDEAS_DIR}${name}`;
    const fm = parseFrontmatter(files[name] ?? "");
    for (const diagnostic of fm.diagnostics)
      diagnostics.push({ file: path, diagnostic });
    if (!fm.present) {
      diagnostics.push({ file: path, diagnostic: warning2("ideas-frontmatter", `${path} has no frontmatter block, so it is not a story; it is skipped.`, slug) });
      continue;
    }
    const { status: rawStatus } = fm.values;
    const status = keyValue(rawStatus);
    if (status !== "idea") {
      const said = status === null ? "has no `status` key" : `says status "${status}"`;
      diagnostics.push({ file: path, diagnostic: warning2("ideas-status", `${path} ${said}; a story says \`status: idea\`, so it is skipped.`, slug) });
      continue;
    }
    const { type: rawType, feature } = fm.rest;
    const type = keyValue(rawType);
    const known = SPEC_TYPES.find((t) => t === type) ?? null;
    if (type !== null && known === null) {
      diagnostics.push({
        file: path,
        diagnostic: warning2("ideas-type", `type "${type}" is not a spec type (${SPEC_TYPES.join(", ")}); the story reads as untyped.`, type)
      });
    }
    ideas.push({
      slug,
      title: goalLine(fm.body) ?? slug,
      type: known,
      feature: keyValue(feature),
      milestone: keyValue(fm.data.milestone),
      priority: fm.data.priority,
      path
    });
  }
  diagnostics.push(...checkIndex(files[INDEX], ideas.map((i) => i.slug)));
  return { ideas, diagnostics };
}

// core/src/recut.ts
function sameTask(a, b) {
  return a.id === b.id && a.text === b.text;
}
function recutBetween(previous, next) {
  const before = new Map(previous.map((task) => [task.id, task.text]));
  const current = new Set(next.map((task) => task.id));
  const struck = previous.filter((task) => !current.has(task.id)).map((task) => task.id);
  const added = next.filter((task) => !before.has(task.id)).map((task) => task.id);
  const changed = next.filter((task) => before.has(task.id) && before.get(task.id) !== task.text).map((task) => task.id);
  return struck.length + added.length + changed.length === 0 ? null : { struck, added, changed };
}

// core/src/stage.ts
var TYPE_NEEDS = {
  bug: { plan: false, tasks: false },
  spike: { plan: false, tasks: false },
  refactor: { plan: false, tasks: true },
  feature: { plan: true, tasks: true },
  project: { plan: true, tasks: true },
  infra: { plan: true, tasks: false },
  chore: { plan: false, tasks: false }
};
var TASKS_THRESHOLD = 3;
function countsOf(input) {
  const p = input.partition;
  if (p) {
    const open = p.takeable + p.open;
    const total2 = open + p.closed + p.dropped;
    return { total: total2, takeable: p.takeable, open, allClosed: total2 > 0 && open === 0 };
  }
  const { closed, total } = input.claims;
  return { total, takeable: input.takeable.length, open: total - closed, allClosed: total > 0 && closed === total };
}
function fullHoldOf(input) {
  if (input.waits?.full === true)
    return input.waits.blockers;
  const held = input.edgeHeld ?? [];
  return held.length > 0 && countsOf(input).takeable === 0 ? held : [];
}
var needs = (input, file) => input.type ? TYPE_NEEDS[input.type][file] : false;
var plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
function takeableIds(input, count2) {
  const ids = input.takeable;
  if (ids.length === 0)
    return plural(count2, "claim");
  if (ids.length === 1)
    return ids[0] ?? "";
  if (ids.length === 2)
    return `${ids[0] ?? ""} and ${ids[1] ?? ""}`;
  return `${ids[0] ?? ""}, ${ids[1] ?? ""} and ${ids.length - 2} more`;
}
function siblingList(ids) {
  if (ids.length === 1)
    return `spec ${ids[0] ?? ""}`;
  if (ids.length === 2)
    return `specs ${ids[0] ?? ""} and ${ids[1] ?? ""}`;
  return `specs ${ids[0] ?? ""}, ${ids[1] ?? ""} and ${ids.length - 2} more`;
}
function fillReason(template, values) {
  return template.replace(/\{([a-zA-Z]+)\}/g, (placeholder, name) => {
    const value = values[name];
    if (value === undefined)
      throw new Error(`stage reason "${template}": no value for ${placeholder}`);
    return value;
  });
}
function commandFor(sub, id, tail) {
  return ["/spec", sub, id, tail].filter((part) => typeof part === "string" && part !== "").join(" ");
}
var SPEC_ARG = "NNN";
var STORY_ARG = "<slug>";
function commandWith(next, arg) {
  return next.split(" ").map((word) => word === SPEC_ARG || word === STORY_ARG ? arg : word).join(" ");
}
var STORY_RULE = {
  subject: "story",
  stage: "idea",
  state: "open",
  condition: "a story file under `specs/ideas/`, no folder yet",
  next: commandFor("new", STORY_ARG),
  reasons: ["the story is shaped but has no spec"]
};
var SPEC_RULES = [
  {
    subject: "spec",
    stage: "done",
    state: "done",
    condition: "`phase: complete`",
    when: (input) => input.phase === "complete",
    next: null,
    reasons: ["phase: complete"],
    explain: () => ({})
  },
  {
    subject: "spec",
    stage: "plan",
    state: "open",
    condition: "the spec has no claims",
    when: (input) => countsOf(input).total === 0,
    next: commandFor("new", SPEC_ARG),
    reasons: ["no claims yet"],
    explain: () => ({})
  },
  {
    subject: "spec",
    stage: "plan",
    state: "open",
    condition: "the type needs `plan.md` and it is missing",
    when: (input) => needs(input, "plan") && !input.hasPlan,
    next: commandFor("plan", SPEC_ARG),
    reasons: ["a {type} spec needs plan.md and it is missing"],
    explain: (input) => ({ values: { type: input.type ?? "typed" } })
  },
  {
    subject: "spec",
    stage: "tasks",
    state: "open",
    condition: "the type needs `tasks.md`, the spec has three or more claims, and `tasks.md` is missing",
    when: (input) => needs(input, "tasks") && countsOf(input).total >= TASKS_THRESHOLD && !input.hasTasks,
    next: commandFor("tasks", SPEC_ARG),
    reasons: ["{claims} and no tasks.md"],
    explain: (input) => ({ values: { claims: plural(countsOf(input).total, "claim") } })
  },
  {
    subject: "spec",
    stage: "review",
    state: "open",
    condition: "the reviewed mark is not fresh",
    when: (input) => input.reviewed !== "fresh",
    next: commandFor("review", SPEC_ARG),
    reasons: ["the reviewed mark is {state}"],
    explain: (input) => ({ values: { state: input.reviewed } })
  },
  {
    subject: "spec",
    stage: "build",
    state: "open",
    condition: "at least one claim is takeable and not all open work waits on an open spec edge",
    when: (input) => countsOf(input).takeable > 0 && fullHoldOf(input).length === 0,
    next: commandFor("implement", SPEC_ARG),
    reasons: ["{ids} {is} takeable"],
    explain: (input) => {
      const count2 = countsOf(input).takeable;
      const many = input.takeable.length === 0 ? count2 !== 1 : input.takeable.length > 1;
      return { values: { ids: takeableIds(input, count2), is: many ? "are" : "is" } };
    }
  },
  {
    subject: "spec",
    stage: "done",
    state: "done",
    condition: "the type is `chore` and every claim is closed",
    when: (input) => input.type === "chore" && countsOf(input).allClosed,
    next: null,
    reasons: ["every claim of the chore is closed"],
    explain: () => ({})
  },
  {
    subject: "spec",
    stage: "close-pending",
    state: "waiting",
    condition: "every claim is closed, the type's workflow has `code_review: feature`, and at least one other spec of the spec's main feature is still open",
    when: (input) => countsOf(input).allClosed && input.codeReview === "feature" && input.featureSiblingsOpen.length > 0,
    next: null,
    reasons: ["every claim is closed and {feature} waits on {siblings}"],
    explain: (input) => ({ values: { feature: input.mainFeature ?? "the feature", siblings: siblingList(input.featureSiblingsOpen) } })
  },
  {
    subject: "spec",
    stage: "code-review",
    state: "open",
    condition: "every claim is closed, the type's workflow has a code review, and the code-reviewed mark is not fresh",
    when: (input) => countsOf(input).allClosed && input.codeReview !== "none" && input.codeReviewed !== "fresh",
    next: commandFor("review", SPEC_ARG, "code"),
    reasons: ["every claim is closed and the code-reviewed mark is {state}"],
    explain: (input) => ({ values: { state: input.codeReviewed } })
  },
  {
    subject: "spec",
    stage: "close",
    state: "open",
    condition: "every claim is closed and either the code-reviewed mark is fresh or the type's workflow has `code_review: none`",
    when: (input) => countsOf(input).allClosed && (input.codeReviewed === "fresh" || input.codeReview === "none"),
    next: commandFor("done", SPEC_ARG),
    reasons: ["every claim is closed and code-reviewed", "every claim is closed and the workflow has no code review"],
    explain: (input) => ({ form: input.codeReview === "none" ? 1 : 0 })
  },
  {
    subject: "spec",
    stage: "blocked",
    state: "waiting",
    condition: "anything else: all open work waits on an open spec edge, or open claims none of which is takeable",
    when: () => true,
    next: commandFor(null, SPEC_ARG),
    reasons: ["{open}, none takeable", "waits on {specs}"],
    explain: (input) => {
      const held = fullHoldOf(input);
      if (held.length > 0)
        return { form: 1, values: { specs: held.join(", ") } };
      return { form: 0, values: { open: plural(countsOf(input).open, "open claim") } };
    }
  }
];
var CLAIMLESS_RULE = SPEC_RULES[1];
function ownRuleOf(stage, withCommand = false) {
  return SPEC_RULES.find((r) => r.stage === stage && r !== CLAIMLESS_RULE && (!withCommand || r.next !== null));
}
var STAGE_RULES = [STORY_RULE, ...SPEC_RULES];
function ruleOf(input) {
  const rule = SPEC_RULES.find((r) => r.when(input));
  if (!rule)
    throw new Error("SPEC_RULES has no fallback row");
  return rule;
}
var rowNumberOf = (rule) => STAGE_RULES.indexOf(rule) + 1;
function nextCommandWithReason(input) {
  const rule = ruleOf(input);
  const { form = 0, values = {} } = rule.explain(input);
  const template = rule.reasons[form];
  if (template === undefined)
    throw new Error(`stage row ${rule.stage} has no reason ${form}`);
  const explicit = explicitStageOf(input);
  return {
    stage: explicit ?? rule.stage,
    stageSource: explicit === null ? "derived" : "explicit",
    command: rule.next === null ? null : commandWith(rule.next, input.number),
    reason: fillReason(template, values),
    row: rowNumberOf(rule)
  };
}
var WAITING_STAGES = new Set(["review", "blocked", "close-pending", "code-review", "close"]);
var escapeRe = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
var CLOSED_PLACEHOLDERS = { is: "(?:is|are)", state: "(?:missing|stale)" };
function templatePattern(template) {
  const seen = new Set;
  const parts = template.split(/(\{[a-zA-Z]+\})/);
  const pattern = parts.map((part, i) => {
    if (i % 2 === 0)
      return escapeRe(part);
    const name = part.slice(1, -1);
    if (seen.has(name))
      return `\\k<${name}>`;
    seen.add(name);
    return `(?<${name}>${CLOSED_PLACEHOLDERS[name] ?? ".+"})`;
  }).join("");
  return new RegExp(`^${pattern}$`);
}
function fillsTemplate(template, phrase) {
  return templatePattern(template).test(phrase);
}
function reasonOf(step) {
  const rule = STAGE_RULES[step.row - 1];
  if (!rule?.reasons.some((template) => fillsTemplate(template, step.reason))) {
    throw new Error(`stage row ${step.row}: "${step.reason}" is not one of its reasons`);
  }
  return step.reason;
}
function stageOf(input) {
  return explicitStageOf(input) ?? ruleOf(input).stage;
}
var WORKFLOW_STAGE_KEYS = {
  idea: true,
  plan: true,
  tasks: true,
  review: true,
  build: true,
  blocked: true,
  "code-review": true,
  "close-pending": true,
  close: true,
  done: true
};
var WORKFLOW_STAGES = Object.keys(WORKFLOW_STAGE_KEYS);
var isWorkflowStage = (value) => Object.hasOwn(WORKFLOW_STAGE_KEYS, value);
var TABLE_STAGES = new Set(SPEC_RULES.map((rule) => rule.stage));
var isStage = (value) => TABLE_STAGES.has(value);
var WORKFLOW_TYPES = ["feature", "project", "infra", "refactor", "bug", "spike", "chore"];
var defaultCodeReview = (type) => type === "chore" ? "none" : "spec";
var CODE_REVIEW_STAGES = new Set(["code-review", "close"]);
var DETOURS = new Set(["blocked", "close-pending"]);
function defaultStages(type) {
  const needs2 = type === null ? { plan: false, tasks: false } : TYPE_NEEDS[type];
  const codeReview = defaultCodeReview(type);
  const keep = (stage) => {
    if (DETOURS.has(stage) || stage === "done")
      return false;
    if (stage === "plan")
      return needs2.plan;
    if (stage === "tasks")
      return needs2.tasks;
    return codeReview !== "none" || !CODE_REVIEW_STAGES.has(stage);
  };
  return [...new Set(SPEC_RULES.map((rule) => rule.stage))].filter(keep).concat("done");
}
function defaultWorkflowRow(type) {
  return { type, stages: defaultStages(type), codeReview: defaultCodeReview(type) };
}
var DEFAULT_WORKFLOW = WORKFLOW_TYPES.map(defaultWorkflowRow);
var DEFAULT = { rows: DEFAULT_WORKFLOW, source: "default", diagnostics: [] };
var rowOf = (type, workflow) => workflow.rows.find((r) => r.type === type) ?? defaultWorkflowRow(type);
function codeReviewOf(type, workflow = DEFAULT) {
  return type === null ? defaultCodeReview(null) : rowOf(type, workflow).codeReview;
}
function workflowStagesOf(type, workflow = DEFAULT) {
  return type === null ? defaultStages(null) : rowOf(type, workflow).stages;
}
function rowTransitions(row) {
  const pairs = [];
  const add = (from, to) => {
    if (!pairs.some((p) => p.from === from && p.to === to))
      pairs.push({ from, to });
  };
  row.stages.forEach((stage, i) => {
    const next = row.stages[i + 1];
    if (next !== undefined)
      add(stage, next);
  });
  add("build", "blocked");
  add("blocked", "build");
  if (row.codeReview === "feature")
    add("build", "close-pending");
  if (row.stages.includes("code-review"))
    add("close-pending", "code-review");
  return pairs;
}
function transitionsOf(workflow) {
  return Object.fromEntries(WORKFLOW_TYPES.map((type) => [type, rowTransitions(rowOf(type, workflow))]));
}
var TRANSITIONS = transitionsOf(DEFAULT);
function placeOf(stage, row) {
  const build2 = row.indexOf("build");
  if (stage === "blocked")
    return build2;
  if (stage === "close-pending")
    return build2 < 0 ? -1 : build2 + 0.5;
  return row.indexOf(stage);
}
function explicitVerdict(input) {
  const value = input.explicitStage;
  if (value === null)
    return { kind: "none" };
  const row = workflowStagesOf(input.type, input.workflow);
  if (!isStage(value) || !row.some((s) => s === value))
    return { kind: "outside", value };
  if (value !== input.lastEventTo)
    return { kind: "contradicted", value };
  const stepBack = input.lastEventFrom !== null && placeOf(value, row) < placeOf(input.lastEventFrom, row);
  if (!stepBack && placeOf(ruleOf(input).stage, row) > placeOf(value, row))
    return { kind: "overtaken", value };
  return { kind: "applies", stage: value };
}
function explicitStageOf(input) {
  const verdict = explicitVerdict(input);
  return verdict.kind === "applies" ? verdict.stage : null;
}
function stageMismatchOf(input, line) {
  const verdict = explicitVerdict(input);
  if (verdict.kind === "none" || verdict.kind === "applies" || verdict.kind === "overtaken")
    return null;
  const why = verdict.kind === "outside" ? `is not a stage of the ${input.type ?? "untyped"} workflow (${workflowStagesOf(input.type, input.workflow).join(" \xB7 ")})` : input.lastEventTo === null ? "is entered by no events.jsonl line" : `is contradicted by the last events.jsonl line, which enters "${input.lastEventTo}"`;
  return {
    severity: "warning",
    code: "stage-mismatch",
    message: `stage "${verdict.value}" ${why}; the derived stage applies.`,
    ...line === undefined ? {} : { line },
    subject: verdict.value
  };
}

// core/src/derived-stages.ts
var DAY_MS = 24 * 60 * 60 * 1000;

// core/src/timeline.ts
function roundLines(text) {
  if (text === undefined)
    return [];
  const out = [];
  for (const raw of text.split(/\r?\n/)) {
    if (raw.trim() === "")
      continue;
    let line;
    try {
      line = JSON.parse(raw);
    } catch {
      continue;
    }
    if (isRecord3(line) && typeof line.round === "number" && typeof line.ts === "string")
      out.push(line);
  }
  return out;
}
function isRecord3(value) {
  return typeof value === "object" && value !== null;
}

// core/src/frames.ts
var CARD_SEVERITY = [
  "fail",
  "question",
  "concerns",
  "waiting",
  "operatorOpen",
  "dispatched",
  "running",
  "done",
  "operatorDone",
  "closed",
  "absent"
];
var RANK = new Map(CARD_SEVERITY.map((state, i) => [state, i]));
function worstState(states) {
  let worst = "closed";
  for (const state of states)
    if ((RANK.get(state) ?? 0) < (RANK.get(worst) ?? 0))
      worst = state;
  return worst;
}
var LANDED = new Set(["done", "operatorDone", "closed"]);
var STATE_WORDS = {
  held: "waiting",
  skipped: "waiting",
  waiting: "waiting",
  dispatched: "dispatched",
  question: "question",
  concerns: "concerns",
  fail: "fail",
  done: "done",
  closed: "closed"
};
function buildFrames(files) {
  const lines = roundLines(files.texts.rounds).map((line, seq) => ({ line, seq, at: Date.parse(line.ts) })).filter((entry) => Number.isFinite(entry.at)).sort((a, b) => a.at - b.at || a.seq - b.seq).map((entry) => entry.line);
  const frames = [];
  let previous = null;
  for (const line of lines) {
    const tasks = tasksOf(line);
    const dispatched = new Set(strings(line.dispatched));
    const recut = previous === null ? null : recutBetween(previous.tasks, tasks);
    const carried = (task) => {
      const before = previous?.cards.get(task.id);
      return before !== undefined && sameTask({ id: before.task, text: before.text }, task) ? before : undefined;
    };
    const resultCards = tasks.map((task) => {
      const before = carried(task)?.tries ?? 0;
      return cardOf(task, { ...recorded(task), tries: before + (dispatched.has(task.id) ? 1 : 0) });
    });
    const dispatchCards = tasks.map((task, i) => {
      const before = carried(task);
      if (dispatched.has(task.id)) {
        const tries = (before?.tries ?? 0) + 1;
        return cardOf(task, {
          state: "dispatched",
          tries,
          ...task.builder === undefined ? {} : { builder: task.builder },
          ...task.reason === undefined ? {} : { reason: task.reason },
          ...tries > 1 && task.note !== undefined ? { note: task.note } : {}
        });
      }
      return before === undefined ? resultCards[i] : cardOf(task, before);
    });
    const claims = claimCounts(line);
    const stop = typeof line.stop === "string" && line.stop !== "" ? line.stop : undefined;
    const shared = { round: line.round, ts: line.ts, ...stop === undefined ? {} : { stop } };
    frames.push(frameOf(frames.length, "dispatch", shared, dispatchCards, {
      closed: Math.max(0, claims.closed - claims.closedThisRound.length),
      total: claims.total
    }, [], recut), frameOf(frames.length + 1, "result", shared, resultCards, { closed: claims.closed, total: claims.total }, claims.closedThisRound, null));
    previous = {
      tasks,
      cards: new Map(resultCards.map((card) => [card.task, card]))
    };
  }
  return frames;
}
function frameOf(index, kind, shared, cards, claims, closedClaims, recut) {
  return {
    index,
    kind,
    round: shared.round,
    ts: shared.ts,
    label: kind === "dispatch" ? `R${shared.round} dispatch` : `R${shared.round}`,
    worst: worstState(cards.map((card) => card.state)),
    cards,
    progress: {
      claims,
      tasks: { landed: cards.filter((card) => LANDED.has(card.state)).length, total: cards.length }
    },
    closedClaims,
    ...shared.stop === undefined ? {} : { stop: shared.stop },
    ...recut === null ? {} : { recut }
  };
}
function cardOf(task, body) {
  return {
    task: task.id,
    claim: task.claim,
    lane: task.lane,
    text: task.text,
    parallel: task.parallel,
    seam: task.seam,
    state: body.state,
    ...body.builder === undefined ? {} : { builder: body.builder },
    ...body.reader === undefined ? {} : { reader: body.reader },
    ...body.verdict === undefined ? {} : { verdict: body.verdict },
    tries: body.tries,
    ...body.reason === undefined ? {} : { reason: body.reason },
    ...body.note === undefined ? {} : { note: body.note }
  };
}
function recorded(task) {
  const known = STATE_WORDS[task.state];
  let state = known ?? "waiting";
  if (task.lane === "operator" && state === "waiting")
    state = "operatorOpen";
  if (task.lane === "operator" && (state === "done" || state === "closed"))
    state = "operatorDone";
  const reason = known === undefined ? [`state "${task.state}"`, ...task.reason === undefined ? [] : [task.reason]].join(" \xB7 ") : task.reason;
  return {
    state,
    ...task.builder === undefined ? {} : { builder: task.builder },
    ...task.reader === undefined ? {} : { reader: task.reader },
    ...task.verdict === undefined ? {} : { verdict: task.verdict },
    ...reason === undefined ? {} : { reason },
    ...task.note === undefined ? {} : { note: task.note }
  };
}
function claimCounts(line) {
  const lists = isRecord4(line.claims) ? line.claims : {};
  const closedThisRound = strings(lists.closed_this_round);
  const progress = typeof line.progress === "string" ? /^\s*(\d+)\s*\/\s*(\d+)\s*$/.exec(line.progress) : null;
  if (progress)
    return { closed: Number(progress[1]), total: Number(progress[2]), closedThisRound };
  const closed = strings(lists.closed).length;
  return { closed, total: closed + strings(lists.open).length, closedThisRound };
}
function tasksOf(line) {
  if (!Array.isArray(line.tasks))
    return [];
  return line.tasks.filter(isRecord4).flatMap((task) => {
    if (typeof task.id !== "string" || task.id === "")
      return [];
    return [
      {
        id: task.id,
        claim: text(task.claim) ?? "",
        lane: text(task.lane) ?? "",
        text: text(task.text) ?? "",
        parallel: task.parallel === true,
        seam: task.seam === true,
        state: text(task.state) ?? "",
        ...optional2("reason", task.reason),
        ...optional2("note", task.note),
        ...optional2("builder", task.builder),
        ...optional2("reader", task.reader),
        ...optional2("verdict", task.verdict)
      }
    ];
  });
}
function optional2(key, value) {
  const v = text(value);
  return v === undefined ? {} : { [key]: v };
}
function text(value) {
  return typeof value === "string" && value !== "" ? value : undefined;
}
function strings(value) {
  return Array.isArray(value) ? value.filter((v) => typeof v === "string") : [];
}
function isRecord4(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

// core/src/status.ts
function stateOf(claim) {
  return claim.dropped ? "dropped" : claim.checked ? "closed" : "open";
}
function heldLocks(locks, claims) {
  const held = new Map;
  for (const lock of locks)
    if (claims.has(lock.claim))
      held.set(lock.claim, lock);
  return [...held.values()].sort((a, b) => a.claim.localeCompare(b.claim, "en", { numeric: true }));
}
function partitionClaims(claims, locks, reviewed) {
  const known = new Set(claims.map((c) => c.id));
  const resolved = new Set(claims.filter((c) => c.checked || c.dropped).map((c) => c.id));
  const lockOf = new Map(locks.map((l) => [l.claim, l]));
  const closed = [];
  const takeable = [];
  const blocked = [];
  const taken = [];
  const open = [];
  const dropped = [];
  const gated = [];
  const diagnostics = [];
  for (const c of claims) {
    for (const b of c.after) {
      if (!known.has(b)) {
        diagnostics.push({
          severity: "warning",
          code: "status-edge-unknown",
          message: `${c.id} is after ${b}, which this file does not hold; the edge counts as unmet.`,
          line: c.line
        });
      }
    }
    if (c.dropped)
      dropped.push(c.id);
    if (c.checked || c.dropped) {
      closed.push(c.id);
      continue;
    }
    open.push(c.id);
    const openBlockers = c.after.filter((b) => !resolved.has(b));
    if (openBlockers.length > 0) {
      blocked.push({ id: c.id, openBlockers });
      continue;
    }
    const lock = lockOf.get(c.id);
    if (lock)
      taken.push({ id: c.id, session: lock.session, since: lock.since });
    else if (reviewed === "fresh")
      takeable.push(c.id);
    else
      gated.push(c.id);
  }
  if (gated.length > 0) {
    diagnostics.push({
      severity: "warning",
      code: "status-review-gate",
      message: `The reviewed mark is ${reviewed}: ${gated.length} ${gated.length === 1 ? "claim stays" : "claims stay"} open, not takeable, until /spec review records a fresh mark.`
    });
  }
  return { closed, takeable, blocked, taken, open, dropped, gated, reviewed, diagnostics };
}
function specEdgeHolds(takeable, edges) {
  const ids = new Set(takeable);
  const held = new Map;
  for (const e of edges) {
    if (e.fromKind !== "claim" || e.state !== "open" || !ids.has(e.fromId))
      continue;
    held.set(e.fromId, [...new Set([...held.get(e.fromId) ?? [], e.toSpec])].sort());
  }
  return held;
}
function progressMismatch(frontmatter, doc, file) {
  const declared = frontmatter.data.progress;
  const counted = countProgress(doc.claims);
  if (declared?.closed === counted.closed && declared.total === counted.total)
    return null;
  const { progress: declaredText } = frontmatter.values;
  return { file, declared: declaredText ?? null, counted: formatProgress(counted) };
}
function masterProgressMismatch(frontmatter, master, file = "ISA.md") {
  return progressMismatch(frontmatter, master, file);
}
function anchorsMissing(doc) {
  return doc.testStrategy.filter((r) => r.cells >= 2 && (r.cells < 6 || r.anchorsTo === "")).length;
}
function mainFeatureOf(isaFeature) {
  const first = isaFeature?.trim().split(/[\s,\u00B7]+/u)[0];
  return first === undefined || first === "" ? null : first;
}
function driftReport(input) {
  const { frontmatter, spec, master } = input;
  const heldElsewhere = input.heldElsewhere ?? new Set;
  const fm = frontmatter.data;
  const byId2 = new Map(spec.claims.map((c) => [c.id, c]));
  const evidence = new Set(spec.verification.map((v) => v.id));
  const evidenceWithoutClose = [...evidence].filter((id) => {
    const c = byId2.get(id);
    return c !== undefined && !c.checked && !c.dropped;
  });
  const feature = mainFeatureOf(fm.isaFeature);
  const missingInSpec = [];
  if (master && feature !== null) {
    const masterById = new Map(master.claims.map((c) => [c.id, c]));
    const block = master.features.find((f) => f.id === feature);
    for (const id of block?.claims ?? []) {
      if (byId2.has(id) || heldElsewhere.has(id) || masterById.get(id)?.dropped)
        continue;
      missingInSpec.push(id);
    }
  }
  const unknownToMaster = [];
  const stateMismatch = [];
  if (master) {
    const masterById = new Map(master.claims.map((c) => [c.id, c]));
    for (const c of spec.claims) {
      const m = masterById.get(c.id);
      if (!m) {
        unknownToMaster.push(c.id);
        continue;
      }
      const specState = stateOf(c);
      const masterState = stateOf(m);
      if (specState !== masterState)
        stateMismatch.push({ id: c.id, spec: specState, master: masterState });
    }
  }
  return {
    unknown_to_master: unknownToMaster,
    state_mismatch: stateMismatch,
    progress_mismatch: progressMismatch(frontmatter, spec, "spec.md"),
    closed_without_evidence: spec.claims.filter((c) => c.checked && !c.dropped && !evidence.has(c.id)).map((c) => c.id),
    evidence_without_close: evidenceWithoutClose,
    missing_in_spec: missingInSpec,
    anchors_missing_at_complete: fm.phase === "complete" && fm.principalStatedGoal ? anchorsMissing(spec) : 0
  };
}
function hasDrift(report) {
  return report.unknown_to_master.length > 0 || report.state_mismatch.length > 0 || report.progress_mismatch !== null || report.closed_without_evidence.length > 0 || report.evidence_without_close.length > 0 || report.missing_in_spec.length > 0 || report.anchors_missing_at_complete > 0;
}

// core/src/takeable.ts
var SERIAL_TYPES = new Set(["bug", "spike", "infra"]);
var UNCHANGEABLE = /closed|locked|blocked|unknown|operator lane|not reviewed|waits on/;
var waitsOnReason = (specs) => `waits on ${[...new Set(specs)].sort().join(", ")}`;
function openSpecEdges(edges) {
  const open = new Map;
  for (const e of edges) {
    if (e.state !== "open")
      continue;
    const key = `${e.fromKind}:${e.fromId}`;
    open.set(key, [...open.get(key) ?? [], e.toSpec]);
  }
  return open;
}
function specEdgeHold(edges) {
  const open = openSpecEdges(edges);
  return (task, claim) => {
    const specs = [...open.get(`task:${task}`) ?? [], ...open.get(`claim:${claim}`) ?? []];
    return specs.length > 0 ? waitsOnReason(specs) : null;
  };
}
function unitsOf(input) {
  if (input.tasks && input.tasks.tasks.length > 0) {
    return input.tasks.tasks.filter((t) => t.state !== "struck").map((t) => ({
      id: t.id,
      claim: t.claim,
      done: t.state === "done",
      parallel: t.flags.parallel,
      seam: t.flags.seam,
      lane: t.lane,
      after: t.edges,
      paths: t.paths
    }));
  }
  return input.claims.filter((c) => !c.checked && !c.dropped).map((c, i) => ({ id: `C${i + 1}`, claim: c.id, done: false, parallel: false, seam: false, lane: null, after: [], paths: [] }));
}
function takeableSet(input) {
  const width = input.width ?? (input.specType !== null && SERIAL_TYPES.has(input.specType) ? 1 : 4);
  const partition = input.partition ?? partitionClaims(input.claims, input.locks ?? [], input.reviewed);
  const waiting = openSpecEdges(input.specEdges ?? []);
  const edgeHold = specEdgeHold(input.specEdges ?? []);
  const takeable = new Set(partition.takeable.filter((id) => !waiting.has(`claim:${id}`)));
  const closed = new Set(partition.closed);
  const blocked = new Map(partition.blocked.map((b) => [b.id, b.openBlockers]));
  const taken = new Map(partition.taken.map((t) => [t.id, t.session]));
  const gated = new Set(partition.gated);
  const units = unitsOf(input);
  const byId2 = new Map(units.map((u) => [u.id, u]));
  const dispatch = [];
  const held = [];
  const filesThisRound = new Set;
  const holdReason = (u) => {
    const waitsOn = edgeHold(u.id, u.claim);
    if (waitsOn !== null)
      return waitsOn;
    if (u.lane === "operator")
      return "operator lane \u2014 the principal's own action, never auto-dispatched";
    if (closed.has(u.claim))
      return "claim already closed \u2014 task should be [x]; strike or check it";
    const blockers = blocked.get(u.claim);
    if (blockers)
      return `claim blocked by ${blockers.join(", ")}`;
    const session = taken.get(u.claim);
    if (session !== undefined)
      return `claim locked by ${session}`;
    if (gated.has(u.claim))
      return `spec not reviewed \u2014 the reviewed mark is ${partition.reviewed}`;
    if (!takeable.has(u.claim))
      return "claim unknown to the spec";
    const openAfter = u.after.filter((a) => byId2.get(a)?.done !== true);
    if (openAfter.length > 0) {
      const seams = openAfter.filter((a) => byId2.get(a)?.seam === true);
      return seams.length > 0 ? `behind open seam ${seams.join(", ")}` : `after ${openAfter.join(", ")} still open`;
    }
    const collision = u.paths.find((p) => filesThisRound.has(p));
    if (collision !== undefined)
      return `same file as a task already in this round: ${collision}`;
    if (dispatch.length >= width)
      return `width ${width} reached`;
    const first = dispatch[0]?.unit;
    if (!first)
      return null;
    if (u.seam)
      return "seam \u2014 runs alone, next round";
    if (!u.parallel)
      return "not [P] \u2014 runs alone, next round";
    if (dispatch.some((d) => !d.unit.parallel))
      return `${first.id} owns this round (${first.seam ? "seam" : "not [P]"})`;
    return null;
  };
  for (const u of units) {
    if (u.done)
      continue;
    const reason = holdReason(u);
    if (reason !== null) {
      held.push({ task: u.id, claim: u.claim, reason });
      continue;
    }
    u.paths.forEach((p) => filesThisRound.add(p));
    const why = u.seam ? "seam \u2014 runs alone before its fan-out" : u.parallel ? "[P], claim takeable, edges closed" : "claim takeable, edges closed";
    dispatch.push({ unit: u, reason: why });
  }
  const open = units.filter((u) => !u.done).length;
  return {
    width,
    claims: [...takeable],
    dispatch: dispatch.map((d) => ({ task: d.unit.id, claim: d.unit.claim, reason: d.reason })),
    held,
    tasks: { landed: units.length - open, total: units.length },
    exhausted: open === 0 || dispatch.length === 0 && held.every((h) => UNCHANGEABLE.test(h.reason))
  };
}

// core/src/tasks.ts
var OPERATOR = "operator";
var CLAIM_ID2 = /^(?:ISC-[\w.-]+|[A-Z]{1,6}-[A-Z0-9][\w.-]*|[A-Z]{1,4}-?\d+(?:\.\d+)*)$/;
var BOX_LINE = /^\s*- \[([ xX])\]\s*(T\d+)\b(.*)$/;
var STRUCK_LINE = /^\s*- ~~(T\d+)\b(.*?)~~(?:\s*[\u2014\u2013-]\s*(.*?))?\s*$/;
var FENCE2 = /^\s*(```|~~~)/;
var AFTER = /\(after:\s*([^)]*)\)/gi;
var TASK_ID2 = /^T\d+$/;
var TASK_RANGE = /^T(\d+)\s*[\u2013\u2014-]\s*T?(\d+)$/;
var FLAG = /^\[[^\]]*\]$/;
var LANE_TOKEN = /^[\w-]+$/;
var STATUS_ORDER = ["open", "dispatched", "held", "question", "concerns", "fail", "done", "closed", "struck"];
var LANDED2 = new Set(["done", "closed"]);
var EDGE_HOLDABLE = new Set(["open", "dispatched", "held"]);
var CARD_STATUS = {
  waiting: "held",
  dispatched: "dispatched",
  running: "dispatched",
  question: "question",
  concerns: "concerns",
  fail: "fail",
  done: "done",
  closed: "closed",
  operatorOpen: "open",
  operatorDone: "done",
  absent: null
};
function codeMask(s) {
  const mask = new Array(s.length).fill(false);
  let i = 0;
  while (i < s.length) {
    if (s[i] !== "`") {
      i++;
      continue;
    }
    let n = 0;
    while (s[i + n] === "`")
      n++;
    const run = "`".repeat(n);
    let close = s.indexOf(run, i + n);
    while (close >= 0 && s[close + n] === "`")
      close = s.indexOf(run, close + n + 1);
    if (close < 0) {
      i += n;
      continue;
    }
    for (let k = i;k < close + n; k++)
      mask[k] = true;
    i = close + n;
  }
  return mask;
}
function indexesOutside(s, sep, mask = codeMask(s)) {
  const out = [];
  for (let i = s.indexOf(sep);i >= 0; i = s.indexOf(sep, i + 1))
    if (!mask[i])
      out.push(i);
  return out;
}
function splitItems(s) {
  const mask = codeMask(s);
  const out = [];
  let depth = 0;
  let start = 0;
  for (let i = 0;i < s.length; i++) {
    if (mask[i])
      continue;
    if (s[i] === "(")
      depth++;
    else if (s[i] === ")")
      depth = Math.max(0, depth - 1);
    else if (depth === 0 && s[i] === "," && s[i + 1] === " ") {
      out.push(s.slice(start, i).trim());
      start = i + 2;
    }
  }
  out.push(s.slice(start).trim());
  return out.filter((item) => item !== "");
}
function takeEdges(s) {
  const mask = codeMask(s);
  const tokens = [];
  let text2 = "";
  let last = 0;
  for (const m of s.matchAll(AFTER)) {
    if (mask[m.index])
      continue;
    tokens.push(...(m[1] ?? "").split(/\s*,\s*/).map((t) => t.trim()).filter((t) => t !== ""));
    text2 += s.slice(last, m.index);
    last = m.index + m[0].length;
  }
  text2 += s.slice(last);
  return { text: text2.replace(/\s{2,}/g, " ").trim(), tokens };
}
function taskIds(tokens) {
  const ids = [];
  const bad = [];
  for (const token of tokens) {
    const range = TASK_RANGE.exec(token);
    if (range) {
      const from = Number(range[1]);
      const to = Number(range[2]);
      if (to >= from && to - from < 1000)
        for (let n = from;n <= to; n++)
          ids.push(`T${n}`);
      else
        bad.push(token);
    } else if (TASK_ID2.test(token))
      ids.push(token);
    else
      bad.push(token);
  }
  return { ids, bad };
}
function pathColumn(tail) {
  const paths = [];
  const notes = [];
  for (const item of splitItems(tail)) {
    const span = /^(`+)(.+?)\1$/.exec(item);
    if (span && !(span[2] ?? "").includes("`"))
      paths.push((span[2] ?? "").trim());
    else if (/^\(.*\)$/.test(item))
      notes.push(item.slice(1, -1).trim());
    else if (/^[^\s`]*[/.][^\s`]*$/.test(item))
      paths.push(item);
    else
      return null;
  }
  return paths.length + notes.length === 0 ? null : { paths, note: notes.length === 0 ? null : notes.join(", ") };
}
function cells(row) {
  const body = row.trim().replace(/^\|/, "").replace(/(?<!\\)\|$/, "");
  return body.split(/(?<!\\)\|/).map((c) => c.replace(/\\\|/g, "|").trim());
}
var SEPARATOR_ROW = /^\|?[\s:|-]+$/;
function section2(lines, heading) {
  const start = lines.findIndex((l) => heading.test(l));
  if (start < 0)
    return [];
  const out = [];
  for (let i = start + 1;i < lines.length && !/^##\s+(?!#)/.test(lines[i] ?? ""); i++)
    out.push({ text: lines[i] ?? "", line: i + 1 });
  return out;
}
function lanesOf(constitution) {
  const rows = section2(constitution.replace(/\r\n?/g, `
`).split(`
`), /^## Lanes\s*$/).filter((l) => l.text.trim().startsWith("|"));
  return rows.slice(1).filter((row) => !SEPARATOR_ROW.test(row.text.trim())).map((row) => (cells(row.text)[0] ?? "").replace(/`/g, "").trim()).filter((name) => name !== "");
}
function parseBody(rest, warn) {
  const body = rest.replace(/^\s*\u00B7\s*/, "");
  const mask = codeMask(body);
  const dash = indexesOutside(body, " \u2014 ", mask)[0];
  let segments;
  let textPart;
  if (dash === undefined) {
    warn("task-malformed", "The task line has no ` \u2014 ` between its head (claim, flags, lane) and its text.");
    const parts = body.split(" \xB7 ");
    const first = (parts[0] ?? "").trim();
    segments = CLAIM_ID2.test(first) ? [first] : [];
    textPart = CLAIM_ID2.test(first) ? parts.slice(1).join(" \xB7 ") : body;
  } else {
    segments = body.slice(0, dash).split("\xB7").map((s) => s.trim()).filter((s) => s !== "");
    textPart = body.slice(dash + 3);
  }
  let claim = "";
  if (segments.length > 0 && CLAIM_ID2.test(segments[0] ?? ""))
    claim = segments.shift() ?? "";
  else if (dash !== undefined) {
    warn("task-no-claim", `The task line names no claim ID: "${segments[0] ?? ""}".`);
    if (segments.length > 1)
      segments.shift();
  }
  let parallel = false;
  let seam = false;
  let lane = "";
  const last = segments[segments.length - 1];
  if (last !== undefined && !FLAG.test(last) && LANE_TOKEN.test(last))
    lane = segments.pop() ?? "";
  else if (dash !== undefined)
    warn("task-no-lane", "The task line has no lane token before ` \u2014 `.");
  for (const seg of segments) {
    if (seg === "[P]")
      parallel = true;
    else if (seg === "[seam]")
      seam = true;
    else if (FLAG.test(seg))
      warn("task-flag-unknown", `Unknown task flag ${seg}; the flags are [P] and [seam].`);
    else
      warn("task-malformed", `Unexpected head segment "${seg}" between the claim and the lane.`);
  }
  const { text: noEdges, tokens } = takeEdges(textPart.trim());
  let text2 = noEdges;
  let paths = [];
  let pathNote = null;
  const sep = indexesOutside(noEdges, " \xB7 ").at(-1);
  if (sep !== undefined) {
    const column = pathColumn(noEdges.slice(sep + 3).trim());
    if (column !== null) {
      text2 = noEdges.slice(0, sep).trim();
      paths = column.paths;
      pathNote = column.note;
    }
  }
  return { claim, parallel, seam, lane, text: text2, edgeTokens: tokens, paths, pathNote };
}
function comparable(text2) {
  const { text: noEdges } = takeEdges(text2);
  const sep = indexesOutside(noEdges, " \xB7 ").at(-1);
  if (sep !== undefined && pathColumn(noEdges.slice(sep + 3).trim()) !== null)
    return noEdges.slice(0, sep).trim();
  return noEdges;
}
function newestCards(rounds) {
  const out = new Map;
  if (rounds === undefined)
    return out;
  for (const frame of buildFrames({ folder: "", texts: { rounds } })) {
    if (frame.kind !== "result" || frame.round === null)
      continue;
    for (const card of frame.cards)
      out.set(card.task, { card, round: frame.round });
  }
  return out;
}
function parseTaskLines(input) {
  const lines = input.tasks.replace(/^\uFEFF/, "").replace(/\r\n?/g, `
`).split(`
`);
  const diagnostics = [];
  const cards = newestCards(input.rounds);
  const tableLanes = input.constitution === undefined ? [] : lanesOf(input.constitution);
  const drafts = [];
  const seen = new Set;
  let fenced = false;
  lines.forEach((raw, index) => {
    const line = index + 1;
    if (FENCE2.test(raw)) {
      fenced = !fenced;
      return;
    }
    if (fenced)
      return;
    const box = BOX_LINE.exec(raw);
    const struck = box ? null : STRUCK_LINE.exec(raw);
    if (!box && !struck)
      return;
    const id = (box ? box[2] : struck?.[1]) ?? "";
    const warn = (code, message) => {
      diagnostics.push({ severity: "warning", code, message: `${id}: ${message}`, line });
    };
    const parsed = parseBody((box ? box[3] : struck?.[2]) ?? "", warn);
    if (seen.has(id))
      warn("task-duplicate-id", `The id ${id} is used by an earlier task line.`);
    seen.add(id);
    if (parsed.lane !== "" && parsed.lane !== OPERATOR && tableLanes.length > 0 && !tableLanes.includes(parsed.lane)) {
      warn("task-lane-unknown", `The lane "${parsed.lane}" is not in the constitution's lane table (${tableLanes.join(", ")}).`);
    }
    const state = struck ? "struck" : box?.[1] === " " ? "open" : "done";
    let status = state;
    let round = null;
    let builder = null;
    let reason = null;
    const hit = struck ? undefined : cards.get(id);
    const fromRound = hit ? CARD_STATUS[hit.card.state] : null;
    if (hit && fromRound !== null && comparable(hit.card.text) === parsed.text && !(state === "done" && !LANDED2.has(fromRound))) {
      status = fromRound;
      round = hit.round;
      builder = hit.card.builder ?? null;
      reason = hit.card.reason ?? null;
    }
    drafts.push({
      id,
      claim: parsed.claim,
      flags: { parallel: parsed.parallel, seam: parsed.seam },
      lane: parsed.lane,
      state,
      edgeTokens: parsed.edgeTokens,
      paths: parsed.paths,
      text: parsed.text,
      line,
      status,
      round,
      builder,
      reason,
      note: struck ? (struck[3] ?? "").trim() || null : null,
      pathNote: parsed.pathNote
    });
  });
  const edgeHold = specEdgeHold(input.specEdges ?? []);
  const itemOf = new Map((input.itemStates ?? []).filter((i) => i.kind === "task").map((i) => [i.id, i]));
  const tasks = drafts.map(({ edgeTokens, ...draft }) => {
    const { edges: taskTokens, specs: afterSpecs } = splitSpecEdges(edgeTokens);
    const { ids, bad } = taskIds(taskTokens);
    const at = (code, message) => {
      diagnostics.push({ severity: "warning", code, message: `${draft.id}: ${message}`, line: draft.line });
    };
    if (bad.length > 0)
      at("task-edge-not-task", `(after: \u2026) names ${bad.join(", ")}, which are no task ids; edges name tasks, not claims.`);
    const unknown = ids.filter((e) => !seen.has(e));
    if (unknown.length > 0)
      at("task-edge-unknown", `(after: \u2026) names ${unknown.join(", ")}, which no task line carries.`);
    const waits = draft.state === "open" && EDGE_HOLDABLE.has(draft.status) ? edgeHold(draft.id, draft.claim) : null;
    const itemState = itemOf.get(draft.id);
    return { ...draft, ...waits === null ? {} : { status: "held", reason: waits }, edges: ids, afterSpecs, ...itemState === undefined ? {} : { itemState } };
  });
  const probeMapping = parseMapping(lines, tasks, diagnostics);
  diagnostics.sort((a, b) => (a.line ?? 0) - (b.line ?? 0));
  const boxes = tasks.filter((t) => t.state !== "struck");
  return {
    tasks,
    probeMapping,
    counts: {
      rows: tasks.length,
      done: tasks.filter((t) => LANDED2.has(t.status)).length,
      boxes: { landed: boxes.filter((t) => t.state === "done").length, total: boxes.length },
      byLane: laneCounts(tasks, tableLanes),
      byStatus: statusCounts(tasks)
    },
    diagnostics
  };
}
function statusCounts(tasks) {
  return STATUS_ORDER.map((name) => ({ name, count: tasks.filter((t) => t.status === name).length })).filter((c) => c.count > 0 || c.name === "done");
}
function laneCounts(tasks, tableLanes) {
  const order = tableLanes.filter((l) => l !== OPERATOR);
  for (const t of tasks)
    if (t.lane !== "" && t.lane !== OPERATOR && !order.includes(t.lane))
      order.push(t.lane);
  order.push(OPERATOR);
  return order.map((name) => ({ name, count: tasks.filter((t) => t.lane === name).length })).filter((c) => c.count > 0);
}
function parseMapping(lines, tasks, diagnostics) {
  const body = section2(lines, /^##\s+Probe Mapping\b/i);
  if (body.length === 0)
    return [];
  const table = body.filter((l) => l.text.trim().startsWith("|"));
  const warn = (code, message, line) => {
    diagnostics.push({ severity: "warning", code, message, line });
  };
  const byId2 = new Map(tasks.map((t) => [t.id, t]));
  const rows = [];
  for (const row of table) {
    const [first = "", claim = "", ...rest] = cells(row.text);
    if (SEPARATOR_ROW.test(row.text.trim()) || /^tasks?$/i.test(first))
      continue;
    const { ids, bad } = taskIds(first.replace(/`/g, "").split(/\s*,\s*/).filter((t) => t !== ""));
    if (bad.length > 0)
      warn("mapping-bad-task", `Probe mapping: ${bad.join(", ")} is no task id or range.`, row.line);
    const id = claim.replace(/`/g, "").trim();
    rows.push({ tasks: ids, claim: id, probe: rest.join(" | ").trim(), line: row.line });
    for (const t of ids) {
      const task = byId2.get(t);
      if (task === undefined)
        warn("mapping-unknown-task", `Probe mapping names ${t}, which no task line carries.`, row.line);
      else if (task.state === "struck")
        warn("mapping-struck-task", `Probe mapping names ${t}, which is struck.`, row.line);
      else if (task.claim !== "" && task.claim !== id)
        warn("mapping-claim-mismatch", `Probe mapping puts ${t} under ${id}; its task line names ${task.claim}.`, row.line);
    }
  }
  const mapped = new Set(rows.flatMap((r) => r.tasks));
  for (const t of tasks) {
    if (t.state !== "struck" && !mapped.has(t.id))
      warn("mapping-missing", `${t.id} has no row in the probe mapping.`, t.line);
  }
  return rows;
}

// core/src/spec-edges.ts
function readSpec(files, num, constitution) {
  const edges = [];
  const openClaims = [];
  const openTasks = [];
  const specText = files.texts.spec;
  if (specText !== undefined) {
    for (const claim of parseClaims(specText).claims) {
      if (!claim.checked && !claim.dropped)
        openClaims.push(claim.id);
      for (const toSpec of claim.afterSpecs) {
        edges.push({ fromSpec: num, fromKind: "claim", fromId: claim.id, toSpec, folder: files.folder, line: claim.line });
      }
    }
  }
  const tasksText = files.texts.tasks;
  if (tasksText !== undefined) {
    const tab = parseTaskLines(constitution === undefined ? { tasks: tasksText } : { tasks: tasksText, constitution });
    for (const task of tab.tasks) {
      if (task.state === "open")
        openTasks.push({ id: task.id, claim: task.claim });
      for (const toSpec of task.afterSpecs ?? []) {
        edges.push({ fromSpec: num, fromKind: "task", fromId: task.id, toSpec, folder: files.folder, line: task.line });
      }
    }
  }
  return { num, folder: files.folder, edges, openClaims, openTasks, files, constitution };
}
function edgeMet(target) {
  return target.branch !== null ? target.merged : target.complete || target.archived;
}
function mergeStates(model, rows) {
  const states = new Map;
  for (const row of rows)
    if (!states.has(row.spec))
      states.set(row.spec, row);
  const fromModel = (files, archived) => {
    const spec = specIdOf(files.folder);
    if (spec === null || states.has(spec))
      return;
    const complete = files.texts.spec !== undefined && parseFrontmatter(files.texts.spec).data.phase === "complete";
    states.set(spec, { spec, branch: null, merged: false, complete, archived });
  };
  for (const files of model.specs)
    fromModel(files, false);
  for (const files of model.archived)
    fromModel(files, true);
  return states;
}
function activeSpecs(model) {
  const seen = new Set;
  const out = [];
  for (const files of model.specs) {
    const num = specIdOf(files.folder);
    if (num === null || seen.has(num))
      continue;
    seen.add(num);
    out.push(readSpec(files, num, model.constitution ?? undefined));
  }
  return out;
}
function resolveEdges(model, mergeState) {
  const states = mergeStates(model, mergeState);
  const specs = activeSpecs(model);
  const cycles = findCycles(specs);
  const cycleOf = new Map;
  for (const cycle of cycles)
    for (const num of cycle.members)
      cycleOf.set(num, cycle);
  const isOpen = (edge) => {
    if (cycleOf.get(edge.fromSpec)?.members.has(edge.toSpec) === true)
      return true;
    const target = states.get(edge.toSpec);
    return target === undefined || !edgeMet(target);
  };
  const edges = [];
  const waits = [];
  for (const spec of specs) {
    const openEdges = new Map;
    for (const edge of spec.edges) {
      const open = isOpen(edge);
      edges.push({ fromSpec: edge.fromSpec, fromKind: edge.fromKind, fromId: edge.fromId, toSpec: edge.toSpec, state: open ? "open" : "met" });
      if (!open)
        continue;
      const key = `${edge.fromKind}:${edge.fromId}`;
      openEdges.set(key, [...openEdges.get(key) ?? [], edge.toSpec]);
    }
    const blockers = new Set;
    const heldClaims = new Set;
    for (const id of spec.openClaims) {
      const on = openEdges.get(`claim:${id}`);
      if (on === undefined)
        continue;
      heldClaims.add(id);
      on.forEach((n) => blockers.add(n));
    }
    let edgeHeld = 0;
    for (const task of spec.openTasks) {
      const own = openEdges.get(`task:${task.id}`) ?? [];
      own.forEach((n) => blockers.add(n));
      if (own.length > 0 || heldClaims.has(task.claim))
        edgeHeld += 1;
    }
    const openTasks = spec.openTasks.length;
    const full = openTasks > 0 ? edgeHeld === openTasks : spec.openClaims.length > 0 && heldClaims.size === spec.openClaims.length;
    const { held: heldTasks, open: readyTasks } = tabCounts(spec, edges.filter((e) => e.fromSpec === spec.num));
    const sorted = [...blockers].sort();
    const unknown = sorted.filter((n) => !states.has(n));
    waits.push({ spec: spec.num, blockers: sorted, ...unknown.length > 0 ? { unknownBlockers: unknown } : {}, heldTasks, readyTasks, openTasks, full });
  }
  return { edges, waits, diagnostics: edgeDiagnostics(model, specs, cycles) };
}
function tabCounts(spec, specEdges) {
  const tasks = spec.files.texts.tasks;
  if (tasks === undefined)
    return { held: 0, open: 0 };
  const rounds = spec.files.texts.rounds;
  const tab = parseTaskLines({
    tasks,
    ...spec.constitution === undefined ? {} : { constitution: spec.constitution },
    ...rounds === undefined ? {} : { rounds },
    specEdges
  });
  const count2 = (name) => tab.counts.byStatus.find((c) => c.name === name)?.count ?? 0;
  return { held: count2("held"), open: count2("open") };
}
function findCycles(specs) {
  const next = new Map;
  for (const spec of specs)
    next.set(spec.num, []);
  for (const spec of specs) {
    for (const edge of spec.edges) {
      const out = next.get(spec.num) ?? [];
      if (next.has(edge.toSpec) && !out.includes(edge.toSpec))
        out.push(edge.toSpec);
    }
  }
  const index = new Map;
  const low = new Map;
  const stack = [];
  const onStack = new Set;
  const groups = [];
  let counter = 0;
  const visit = (v) => {
    index.set(v, counter);
    low.set(v, counter);
    counter += 1;
    stack.push(v);
    onStack.add(v);
    for (const w2 of next.get(v) ?? []) {
      if (!index.has(w2)) {
        visit(w2);
        low.set(v, Math.min(low.get(v) ?? 0, low.get(w2) ?? 0));
      } else if (onStack.has(w2)) {
        low.set(v, Math.min(low.get(v) ?? 0, index.get(w2) ?? 0));
      }
    }
    if (low.get(v) !== index.get(v))
      return;
    const group = [];
    let w;
    do {
      w = stack.pop();
      if (w === undefined)
        break;
      onStack.delete(w);
      group.push(w);
    } while (w !== v);
    groups.push(group);
  };
  for (const v of next.keys())
    if (!index.has(v))
      visit(v);
  const cycles = [];
  for (const group of groups) {
    const carrier = [...group].sort()[0];
    const members = new Set(group);
    if (group.length === 1 && !(next.get(carrier) ?? []).includes(carrier))
      continue;
    cycles.push({ members, carrier, path: shortestLoop(carrier, members, next) });
  }
  return cycles.sort((a, b) => a.carrier.localeCompare(b.carrier));
}
function shortestLoop(start, members, next) {
  const from = new Map;
  const queue = [start];
  for (const v of queue) {
    for (const w of [...next.get(v) ?? []].sort()) {
      if (!members.has(w))
        continue;
      if (w === start) {
        const path = [start];
        for (let at = v;at !== undefined && at !== start; at = from.get(at))
          path.splice(1, 0, at);
        return [...path, start];
      }
      if (from.has(w))
        continue;
      from.set(w, v);
      queue.push(w);
    }
  }
  return [start, start];
}
function fileOfEdge(edge) {
  return specFilePath(`specs/${edge.folder}`, edge.fromKind === "claim" ? "spec" : "tasks");
}
function edgeDiagnostics(model, specs, cycles) {
  const known = new Set;
  for (const files of [...model.specs, ...model.archived]) {
    const num = specIdOf(files.folder);
    if (num !== null)
      known.add(num);
  }
  const out = [];
  for (const spec of specs) {
    for (const edge of spec.edges) {
      if (known.has(edge.toSpec))
        continue;
      const diagnostic = {
        severity: "warning",
        code: "spec-edge-unknown",
        message: `The spec edge (after: ${edge.toSpec}) on ${edge.fromId} names no spec, active or archived; it stays open.`,
        line: edge.line,
        subject: edge.toSpec
      };
      out.push({ file: fileOfEdge(edge), diagnostic });
    }
  }
  const bySpec = new Map(specs.map((s) => [s.num, s]));
  for (const cycle of cycles) {
    const step = cycle.path[1];
    const edge = bySpec.get(cycle.carrier)?.edges.find((e) => e.toSpec === step);
    if (edge === undefined)
      continue;
    const path = cycle.path.join(" \u2192 ");
    const diagnostic = {
      severity: "warning",
      code: "spec-edge-cycle",
      message: `Spec edges form the cycle ${path}; every edge in it stays open.`,
      line: edge.line,
      subject: path
    };
    out.push({ file: fileOfEdge(edge), diagnostic });
  }
  return out;
}

// core/src/tldr.ts
var TLDR_SECTIONS = ["overview", "try", "per-spec", "risks", "next"];
var MARKER = /<!--\s*section:\s*([\w-]+)\s*-->/;
function names2(text2, number) {
  return new RegExp(String.raw`\b${number.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\b`).test(text2);
}
var LANG_TAG = /^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$/;
function langOf(value) {
  const lang = value?.trim() ?? "";
  return LANG_TAG.test(lang) ? lang : null;
}
function parseTldr(text2) {
  const fm = parseFrontmatter(text2);
  const diagnostics = [...fm.diagnostics];
  const generated = fm.values.generated ?? null;
  if (generated === null || generated === "") {
    diagnostics.push({ severity: "warning", code: "tldr-generated-missing", message: "The TL;DR carries no `generated:` time, so it counts as stale." });
  } else if (Number.isNaN(Date.parse(generated))) {
    diagnostics.push({ severity: "warning", code: "tldr-generated-invalid", message: `generated ${generated} is no ISO 8601 time, so the TL;DR counts as stale.` });
  }
  return {
    generated: generated === "" ? null : generated,
    sections: sectionsByMarker(fm.body),
    lang: langOf(fm.values.lang),
    diagnostics
  };
}
function sectionsByMarker(body) {
  const sections = new Map;
  const parts = body.split(new RegExp(MARKER.source));
  for (let i = 1;i < parts.length; i += 2) {
    const key = parts[i] ?? "";
    const part = (parts[i + 1] ?? "").trim();
    const before = sections.get(key);
    sections.set(key, before === undefined ? part : [before, part].filter((s) => s !== "").join(`

`));
  }
  return Object.fromEntries(sections);
}
function tldrState(input) {
  const { tldr, specs } = input;
  if (!tldr)
    return { present: false, stale: false, missingSections: [], unnamedSpecs: [] };
  const at = tldr.generated === null ? Number.NaN : Date.parse(tldr.generated);
  const stale = Number.isNaN(at) || specs.some((s) => [s.updated, s.lastRound ?? null].some((ts) => ts !== null && Date.parse(ts) > at));
  const text2 = Object.values(tldr.sections).join(`
`);
  return {
    present: true,
    stale,
    missingSections: TLDR_SECTIONS.filter((k) => !Object.hasOwn(tldr.sections, k)),
    unnamedSpecs: specs.filter((s) => s.phase !== "complete" && !names2(text2, s.number)).map((s) => s.number)
  };
}

// core/src/dashboard.ts
var STAGE_GROUPS = ["scoping", "building", "complete"];
var STAGES = ["plan", "tasks", "review", "build", "blocked", "code-review", "close-pending", "close", "done"];
var ACTION_ORDER = ["close", "code-review", "review", "build", "blocked", "tasks", "plan", "close-pending", "done"];
var BUILDING = new Set(["build", "blocked", "code-review", "close-pending"]);
var stageGroupOf = (stage) => stage === "done" ? "complete" : BUILDING.has(stage) ? "building" : "scoping";
var WARNING_ORDER = ["drift", "review", "diagrams", "closed", "fog", "spec-overlap", "spec-edge", "locks", "worktree-branch-mismatch"];
var AFTER_EDGE_WARNINGS = new Set(["locks", "worktree-branch-mismatch"]);
var NEXT_UP = 3;
var MASTER_FILE = "ISA.md";
var CONSTITUTION_FILE = "specs/constitution.md";
var TLDR_FILE = "specs/tldr.md";
var plural2 = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
var fileOf = (base, folder, kind) => specFilePath(`${base}/${folder}`, kind);
function devServiceLabels(constitution) {
  const labels = new Map;
  const value = parseFrontmatter(constitution).values.dev_services ?? "";
  for (const entry of value.split(",")) {
    const at = entry.indexOf("=");
    const port = Number(entry.slice(0, at).trim());
    const label = entry.slice(at + 1).trim();
    if (at > 0 && Number.isInteger(port) && port > 0 && port < 65536 && label !== "")
      labels.set(port, label);
  }
  return labels;
}
function readMark(gate, text2) {
  return text2 === undefined ? null : readGateMark(gate, text2);
}
function newestRound(text2) {
  const diagnostics = [];
  let ts = null;
  (text2 ?? "").split(/\r?\n/).forEach((line, i) => {
    if (line.trim() === "")
      return;
    let value;
    try {
      value = JSON.parse(line);
    } catch {
      diagnostics.push({ severity: "warning", code: "rounds-line-invalid", message: "The line is not JSON; the round is skipped.", line: i + 1 });
      return;
    }
    const at = typeof value === "object" && value !== null && "ts" in value ? value.ts : undefined;
    if (typeof at !== "string" || Number.isNaN(Date.parse(at))) {
      diagnostics.push({ severity: "warning", code: "rounds-ts-missing", message: "The round carries no ISO 8601 `ts`.", line: i + 1 });
      return;
    }
    if (ts === null || Date.parse(at) > Date.parse(ts))
      ts = at;
  });
  return { ts, diagnostics };
}
function reviewedView(check, reading) {
  const at = check.at === null ? {} : { at: check.at };
  if (check.state === "missing")
    return { state: "missing", detail: "no reviewed mark" };
  if (check.state === "stale") {
    const detail = check.changed.length > 0 ? `changed since the review: ${check.changed.join(", ")}` : "the mark cannot be compared";
    return { state: "stale", detail, ...at, files: check.changed };
  }
  const mark = reading?.mark;
  const files = mark?.gate === "reviewed" ? Object.keys(mark.files).filter((f) => mark.files[f] !== null) : [];
  return { state: "fresh", detail: `matches ${files.join(", ")}`, ...at, files };
}
function codeReviewedView(check) {
  const at = check.at === null ? {} : { at: check.at };
  if (check.state === "missing")
    return { state: "missing", detail: "no code-reviewed mark" };
  if (check.state === "stale")
    return { state: "stale", detail: check.detail ?? "the working tree changed since the code review", ...at };
  return { state: "fresh", detail: "matches the working tree", ...at };
}
function driftClasses(report) {
  return Object.keys(report).filter((key) => {
    const value = report[key];
    return Array.isArray(value) ? value.length > 0 : typeof value === "number" ? value > 0 : value !== null;
  });
}
function driftView(report) {
  if (report === null)
    return { state: "na", detail: "no master ISA.md" };
  if (!hasDrift(report))
    return { state: "ok", detail: "in step with the master" };
  return { state: "warn", detail: `drift: ${driftClasses(report).join(", ")}` };
}
function diagramsView(verdict) {
  if (verdict.level === "skip")
    return { state: "na", detail: "no diagram required" };
  if (verdict.level === "ok")
    return { state: "ok", detail: "mermaid diagram present" };
  return { state: "warn", detail: `no mermaid diagram in ${verdict.missing.join(", ")}`, files: verdict.missing };
}
function holdsFeatureOpen(phase, doc) {
  return phase !== "complete" && doc.claims.some((c) => !c.checked && !c.dropped);
}
var ACTIVITY_FILE = ".spectant/activity.jsonl";
function lockWarning(d) {
  const activity = d.code.startsWith("locks-activity") || d.code === "activity-event-unknown";
  const where = activity ? `${ACTIVITY_FILE}${d.line === undefined ? "" : ` line ${d.line}`}` : "LifeOS frontier locks";
  const ref = d.claim ?? (activity ? ACTIVITY_FILE : undefined);
  return { kind: "locks", text: `${where}: ${d.message}`, ...ref === undefined ? {} : { ref } };
}
function worktreeWarning(d, worktree) {
  return { kind: "worktree-branch-mismatch", text: d.message, ...worktree?.path == null ? {} : { ref: worktree.path } };
}
function mainCopyOf(files, ctx) {
  const spec = files.texts.spec;
  if (spec === undefined)
    return null;
  const basis = stageBasisOf(files, spec, specIdOf(files.folder) ?? files.folder, ctx, ctx.worktreeTree);
  return { stage: nextCommandWithReason(basis.input).stage, progress: basis.doc.counted };
}
function stageBasisOf(f, spec, id, ctx, tree) {
  const plan = f.texts.plan ?? null;
  const fm = parseFrontmatter(spec);
  const doc = parseClaims(spec);
  const { reading: reviewedMark, check: reviewed } = reviewedGate(f.texts);
  const partition = partitionClaims(doc.claims, ctx.locks, reviewed.state);
  const edgeHeld = specEdgeHolds(partition.takeable, ctx.specEdges.get(id) ?? []);
  const takeable = partition.takeable.filter((c) => !edgeHeld.has(c));
  const codeMark = readMark("code-reviewed", f.texts.gateCodeReviewed);
  const codeReviewed = gateState("code-reviewed", codeMark?.mark ?? null, { worktreeTree: tree });
  const { specType: type, phase } = fm.data;
  const events = f.texts.events === undefined ? [] : parseEvents(f.texts.events).events;
  const lastTo = events.at(-1)?.to ?? null;
  const lastEventTo = lastTo !== null && isWorkflowStage(lastTo) ? lastTo : null;
  const lastFrom = events.at(-1)?.from ?? null;
  const lastEventFrom = lastFrom !== null && isWorkflowStage(lastFrom) ? lastFrom : null;
  const mainFeature = mainFeatureOf(fm.data.isaFeature);
  const featureSiblingsOpen = mainFeature === null ? [] : (ctx.openByFeature.get(mainFeature) ?? []).filter((other) => other !== id);
  const input = {
    number: id,
    type,
    phase,
    hasPlan: plan !== null,
    hasTasks: f.texts.tasks !== undefined,
    claims: doc.counted,
    reviewed: reviewed.state,
    codeReviewed: codeReviewed.state,
    takeable,
    partition: {
      takeable: takeable.length,
      open: partition.open.length - takeable.length,
      closed: partition.closed.length - partition.dropped.length,
      dropped: partition.dropped.length
    },
    explicitStage: fm.data.stage,
    lastEventTo,
    lastEventFrom,
    ...ctx.workflow === undefined ? {} : { workflow: ctx.workflow },
    codeReview: codeReviewOf(type, ctx.workflow),
    mainFeature,
    featureSiblingsOpen,
    waits: ctx.waits.get(id) ?? null,
    edgeHeld: [...new Set([...edgeHeld.values()].flat())].sort()
  };
  return { fm, doc, plan, reviewedMark, reviewed, partition, takeable, codeMark, codeReviewed, events, input };
}
function heldElsewhere(ctx, folder) {
  const held = new Set;
  for (const [other, ids] of ctx.idsByFolder)
    if (other !== folder)
      ids.forEach((id) => held.add(id));
  return held;
}
function specRow(f, ctx, diagnostics) {
  const note = (kind, list) => list.forEach((diagnostic) => diagnostics.push({ file: fileOf("specs", f.folder, kind), diagnostic }));
  const spec = f.texts.spec;
  if (spec === undefined) {
    note("spec", [{ severity: "error", code: "spec-missing", message: "The folder has no spec.md, so it is not a spec and gets no row." }]);
    return null;
  }
  const id = specIdOf(f.folder) ?? f.folder;
  const read = ctx.perSpec[f.folder] ?? {};
  const tree = read.tree === undefined ? ctx.worktreeTree : read.tree;
  const { fm, doc, plan, reviewedMark, reviewed, partition, takeable, codeMark, codeReviewed, events, input: stageInput } = stageBasisOf(f, spec, id, ctx, tree);
  const ids = new Set(doc.claims.map((c) => c.id));
  const taken = heldLocks(ctx.locks, ids).map((l) => ({ id: l.claim, session: l.session, since: l.since, source: l.source }));
  const partitionWarnings = partition.diagnostics.filter((d) => d.code !== "status-review-gate");
  note("spec", [...fm.diagnostics, ...doc.diagnostics, ...partitionWarnings]);
  note("gateReviewed", reviewedMark?.diagnostics ?? []);
  note("gateCodeReviewed", codeMark?.diagnostics ?? []);
  const { specType: type, phase } = fm.data;
  const next = nextCommandWithReason(stageInput);
  const mismatch = stageMismatchOf(stageInput, fm.keyLines.stage);
  if (mismatch !== null)
    note("spec", [mismatch]);
  const drift = ctx.master === null ? null : driftReport({ frontmatter: fm, spec: doc, master: ctx.master, heldElsewhere: heldElsewhere(ctx, f.folder) });
  const diagrams = diagramVerdict({ type, phase, spec, plan });
  const fog = doc.fog.length;
  const rounds = newestRound(f.texts.rounds);
  note("rounds", rounds.diagnostics);
  if (f.texts.events !== undefined)
    note("events", parseEvents(f.texts.events).diagnostics);
  const warnings = [];
  if (drift !== null && hasDrift(drift)) {
    warnings.push({ kind: "drift", text: `drift to the master: ${driftClasses(drift).join(", ")}`, command: commandFor(null, id) });
  }
  if (phase !== "complete") {
    if (reviewed.state !== "fresh") {
      const text2 = reviewed.state === "stale" ? `reviewed mark is stale (${reviewed.changed.join(", ") || "unreadable"})` : "no reviewed mark yet";
      warnings.push({ kind: "review", text: text2, command: commandFor("review", id) });
    }
    const missing = diagrams.missing.filter((file) => file === "spec.md" || plan !== null);
    if (diagrams.level === "fail" && missing.length > 0) {
      warnings.push({ kind: "diagrams", text: `diagram missing in ${missing.join(", ")}`, ref: missing.join(", ") });
    }
    if (doc.counted.total > 0 && doc.counted.closed === doc.counted.total && next.command !== null) {
      warnings.push({ kind: "closed", text: "every claim closed, phase not complete" });
    }
    if (fog > 0)
      warnings.push({ kind: "fog", text: plural2(fog, "open fog line") });
    for (const d of ctx.lockDiagnostics) {
      if (d.claim === undefined || ids.has(d.claim))
        warnings.push(lockWarning(d));
    }
  }
  const worktree = ctx.worktrees.find((w) => w.kind === "spec" && w.spec === id) ?? null;
  for (const d of ctx.worktreeDiagnostics)
    if (d.subject === id)
      warnings.push(worktreeWarning(d, worktree));
  const source = read.source ?? "main";
  const main = source === "worktree" && read.main !== undefined ? mainCopyOf(read.main, ctx) : null;
  const summary = listArchive([f])[0];
  return {
    id,
    slug: f.folder,
    title: specTitle(summary, f.folder),
    type,
    priority: fm.data.priority,
    phase,
    stage: next.stage,
    stageGroup: stageGroupOf(next.stage),
    stageSource: next.stageSource,
    progress: doc.counted,
    tasks: f.texts.tasks === undefined ? null : summary?.tasks ?? { landed: 0, total: 0 },
    nextCommand: next.command,
    nextReason: reasonOf(next),
    takeable,
    taken,
    assignee: assigneeOf({ claims: ids, locks: ctx.locks, events }),
    warnings,
    gates: {
      reviewed: reviewedView(reviewed, reviewedMark),
      codeReviewed: codeReviewedView(codeReviewed),
      drift: driftView(drift),
      diagrams: diagramsView(diagrams)
    },
    fog,
    updated: fm.data.updated,
    lastRound: rounds.ts,
    goal: summary?.goal ?? "",
    worktree,
    source,
    main,
    waits: waitsOf(ctx.waits.get(id))
  };
}
var waitsOf = (wait) => wait === undefined || wait.blockers.length === 0 ? null : wait;
function edgesBySpec(edges) {
  const by = new Map;
  for (const e of edges)
    by.set(e.fromSpec, [...by.get(e.fromSpec) ?? [], e]);
  return by;
}
var AFFECTED_HEADING = /^##\s+Affected Files and Modules\s*$/i;
var PATH_LIKE = /^[^\s`]*[/.][^\s`]*$/;
function affectedPaths(plan) {
  const out = [];
  let inside = false;
  let fenced = false;
  for (const line of plan.split(/\r?\n/)) {
    if (/^\s*(```|~~~)/.test(line))
      fenced = !fenced;
    if (fenced)
      continue;
    if (/^##\s/.test(line)) {
      inside = AFFECTED_HEADING.test(line.trim());
      continue;
    }
    if (!inside || !line.trim().startsWith("|") || TABLE_SEP.test(line))
      continue;
    const cell = tableCells2(line)[0] ?? "";
    const spans = [...cell.matchAll(/`([^`]+)`/g)].map((m) => (m[1] ?? "").trim()).filter((p) => p !== "");
    if (spans.length > 0)
      out.push(...spans);
    else if (PATH_LIKE.test(cell))
      out.push(cell);
  }
  return out;
}
var normalisePath = (path) => path.trim().replace(/\\/g, "/").replace(/^(\.\/)+/, "").replace(/\/{2,}/g, "/");
function sharedFilesOf(constitution) {
  if (constitution === null)
    return [];
  const raw = parseFrontmatter(constitution).values.shared_files;
  if (raw === undefined)
    return [];
  return raw.trim().replace(/^\[/, "").replace(/\]$/, "").split(",").map((entry) => normalisePath(entry.trim().replace(/^["'`]|["'`]$/g, ""))).filter((entry) => entry !== "");
}
function globPattern(glob) {
  let source = "";
  for (let i = 0;i < glob.length; i += 1) {
    const c = glob[i];
    if (c === "*" && glob[i + 1] === "*") {
      source += ".*";
      i += 1;
    } else if (c === "*")
      source += "[^/]*";
    else if (c === "?")
      source += "[^/]";
    else
      source += c.replace(/[.+^${}()|[\]\\]/g, "\\$&");
  }
  return new RegExp(`^${source}$`, "u");
}
function covers(pattern, path) {
  if (pattern === path)
    return true;
  if (pattern.endsWith("/"))
    return path.startsWith(pattern);
  return /[*?]/.test(pattern) && globPattern(pattern).test(path);
}
function commonPaths(a, b) {
  const out = new Set;
  for (const pa of a) {
    for (const pb of b) {
      if (pa === pb)
        out.add(pa);
      else if (covers(pa, pb))
        out.add(pb);
      else if (covers(pb, pa))
        out.add(pa);
    }
  }
  return [...out].sort();
}
var STAGE_RANK = {
  plan: 0,
  tasks: 1,
  review: 2,
  build: 3,
  blocked: 3,
  "code-review": 4,
  close: 5,
  "close-pending": 5,
  done: 6
};
var ratio = (p) => p.total === 0 ? 0 : p.closed / p.total;
function waitingOf(a, b) {
  const byStage = STAGE_RANK[a.stage] - STAGE_RANK[b.stage];
  if (byStage !== 0)
    return byStage < 0 ? a : b;
  const byProgress = ratio(a.progress) - ratio(b.progress);
  if (byProgress !== 0)
    return byProgress < 0 ? a : b;
  return a.num > b.num ? a : b;
}
function specOverlaps(specs, edges, sharedFiles) {
  const joined = new Set(edges.flatMap((e) => [`${e.fromSpec}>${e.toSpec}`, `${e.toSpec}>${e.fromSpec}`]));
  const shared = sharedFiles.map(normalisePath);
  const sorted = [...specs].sort((a, b) => a.num < b.num ? -1 : a.num > b.num ? 1 : 0);
  const pathsOf = new Map(sorted.map((s) => [s.num, [...new Set(s.paths.map(normalisePath).filter((p) => p !== ""))]]));
  const out = [];
  sorted.forEach((a, i) => {
    for (const b of sorted.slice(i + 1)) {
      if (a.num === b.num || joined.has(`${a.num}>${b.num}`))
        continue;
      const paths = commonPaths(pathsOf.get(a.num) ?? [], pathsOf.get(b.num) ?? []).filter((p) => !shared.some((s) => covers(s, p)));
      if (paths.length === 0)
        continue;
      const waiting = waitingOf(a, b);
      const other = waiting === a ? b : a;
      out.push({ specs: [a.num, b.num], paths, waiting: waiting.num, edge: `(after: ${other.num})` });
    }
  });
  return out;
}
var baseName = (file) => file.slice(file.lastIndexOf("/") + 1);
function edgeWarnings(rows, active, edges, constitution) {
  const out = new Map;
  const add = (id, warning3) => void out.set(id, [...out.get(id) ?? [], warning3]);
  const idOf = new Map(rows.map((r) => [r.slug, r.id]));
  for (const { file, diagnostic } of edges.diagnostics) {
    const id = idOf.get(file.split("/")[1] ?? "");
    if (id !== undefined)
      add(id, { kind: "spec-edge", text: diagnostic.message, ref: baseName(file) });
  }
  const filesOf = new Map(active.map((f) => [f.folder, f]));
  const open = rows.flatMap((r) => {
    const texts = filesOf.get(r.slug)?.texts;
    if (r.stage === "done" || texts === undefined)
      return [];
    const tasks = texts.tasks === undefined ? [] : parseTaskLines(constitution === null ? { tasks: texts.tasks } : { tasks: texts.tasks, constitution }).tasks;
    return [{ num: r.id, stage: r.stage, progress: r.progress, paths: [...affectedPaths(texts.plan ?? ""), ...tasks.flatMap((t) => t.paths)] }];
  });
  for (const overlap of specOverlaps(open, edges.edges, sharedFilesOf(constitution))) {
    const other = overlap.specs[0] === overlap.waiting ? overlap.specs[1] : overlap.specs[0];
    add(overlap.waiting, { kind: "spec-overlap", text: `shares ${plural2(overlap.paths.length, "file")} with ${other}, no edge`, overlap });
  }
  return out;
}
var byFolder = (a, b) => a.folder < b.folder ? -1 : a.folder > b.folder ? 1 : 0;
var byAction = (a, b) => ACTION_ORDER.indexOf(a.stage) - ACTION_ORDER.indexOf(b.stage) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0) || (a.slug < b.slug ? -1 : a.slug > b.slug ? 1 : 0);
var sum = (rows, of) => rows.reduce((n, r) => n + of(r), 0);
function buildDashboard(input) {
  const diagnostics = [];
  const note = (file, list) => list.forEach((diagnostic) => diagnostics.push({ file, diagnostic }));
  let master = null;
  let masterFog = 0;
  if (input.master !== null) {
    const fm = parseFrontmatter(input.master);
    master = parseClaims(input.master);
    masterFog = master.fog.length;
    note(MASTER_FILE, [...fm.diagnostics, ...master.diagnostics]);
    const mismatch = fm.present && master.section !== null ? masterProgressMismatch(fm, master, MASTER_FILE) : null;
    if (mismatch) {
      note(MASTER_FILE, [
        { severity: "warning", code: "master-progress-mismatch", message: `progress ${mismatch.declared ?? "(none)"} disagrees with the recount ${mismatch.counted}.` }
      ]);
    }
  }
  let labels = new Map;
  if (input.constitution !== null) {
    note(CONSTITUTION_FILE, parseFrontmatter(input.constitution).diagnostics);
    labels = devServiceLabels(input.constitution);
  }
  const active = [...input.specs].sort(byFolder);
  const archived = [...input.archived].sort(byFolder);
  const idsByFolder = new Map;
  const openByFeature = new Map;
  for (const f of [...active, ...archived]) {
    if (f.texts.spec === undefined)
      continue;
    const doc = parseClaims(f.texts.spec);
    idsByFolder.set(f.folder, new Set(doc.claims.map((c) => c.id)));
    if (!active.includes(f))
      continue;
    const fm = parseFrontmatter(f.texts.spec).data;
    const feature = mainFeatureOf(fm.isaFeature);
    if (feature !== null && holdsFeatureOpen(fm.phase, doc))
      openByFeature.set(feature, [...openByFeature.get(feature) ?? [], specIdOf(f.folder) ?? f.folder]);
  }
  const edges = resolveEdges({ specs: active, archived, constitution: input.constitution }, input.mergeState ?? []);
  const ctx = {
    master,
    idsByFolder,
    locks: input.locks?.locks ?? [],
    lockDiagnostics: input.locks?.diagnostics ?? [],
    worktreeTree: input.worktreeTree ?? null,
    perSpec: input.perSpec ?? {},
    worktrees: input.worktrees?.worktrees ?? [],
    worktreeDiagnostics: input.worktrees?.diagnostics ?? [],
    workflow: input.workflow,
    openByFeature,
    waits: new Map(edges.waits.map((w) => [w.spec, w])),
    specEdges: edgesBySpec(edges.edges)
  };
  const built = active.flatMap((f) => specRow(f, ctx, diagnostics) ?? []).sort(byAction);
  const extra = edgeWarnings(built, active, edges, input.constitution);
  const rows = built.map((r) => {
    const more = extra.get(r.id);
    if (more === undefined)
      return r;
    const at = r.warnings.findIndex((w) => AFTER_EDGE_WARNINGS.has(w.kind));
    const cut = at === -1 ? r.warnings.length : at;
    return { ...r, warnings: [...r.warnings.slice(0, cut), ...more, ...r.warnings.slice(cut)] };
  });
  for (const f of archived) {
    if (f.texts.spec === undefined) {
      note(fileOf("specs/archive", f.folder, "spec"), [{ severity: "error", code: "spec-missing", message: "The archived folder has no spec.md and is not listed." }]);
    }
  }
  const archive = listArchive(archived);
  let brief = null;
  if (input.tldr !== null) {
    const tldr = parseTldr(input.tldr);
    note(TLDR_FILE, tldr.diagnostics);
    const state = tldrState({ tldr, specs: rows.map((r) => ({ number: r.id, updated: r.updated, phase: r.phase, lastRound: r.lastRound })) });
    brief = {
      markdown: parseFrontmatter(input.tldr).body.trim(),
      generated: tldr.generated,
      stale: state.stale,
      sections: tldr.sections,
      lang: tldr.lang,
      ...input.tldrSource?.kind === "worktree" ? { source: input.tldrSource } : {}
    };
  }
  const stageCounts = Object.fromEntries(STAGES.map((stage) => [stage, rows.filter((r) => r.stage === stage).length]));
  const open = rows.filter((r) => r.stage !== "done");
  const warnings = sum(rows, (r) => r.warnings.length);
  const fog = masterFog + sum(rows, (r) => r.fog);
  const stageGroups = Object.fromEntries(STAGE_GROUPS.map((g) => [g, rows.filter((r) => r.stageGroup === g).length]));
  const masterCount = master !== null && master.section !== null ? master.counted : null;
  const types = [...new Set(rows.flatMap((r) => r.type === null ? [] : [r.type]))].sort();
  const byType = Object.fromEntries(types.map((t) => [t, rows.filter((r) => r.type === t).length]));
  const kpis = {
    specs: rows.length,
    building: stageGroups.building,
    scoping: stageGroups.scoping,
    stageGroups,
    master: masterCount,
    masterOpen: masterCount === null ? null : Math.max(0, masterCount.total - masterCount.closed),
    masterPercent: masterCount === null || masterCount.total === 0 ? null : Math.floor(masterCount.closed / masterCount.total * 100),
    byType,
    claims: { closed: sum(open, (r) => r.progress.closed), total: sum(open, (r) => r.progress.total) },
    tasks: { landed: sum(open, (r) => r.tasks?.landed ?? 0), total: sum(open, (r) => r.tasks?.total ?? 0) },
    takeable: sum(rows, (r) => r.takeable.length),
    openClaims: sum(rows, (r) => r.progress.total - r.progress.closed),
    warnings,
    specsWithWarnings: rows.filter((r) => r.warnings.length > 0).length,
    fog,
    specsWithFog: rows.filter((r) => r.fog > 0).length,
    masterFog,
    attention: warnings + fog,
    archived: archive.length
  };
  const warningGroups = WARNING_ORDER.map((kind) => ({
    kind,
    items: rows.flatMap((r) => r.warnings.filter((w) => w.kind === kind).map((warning3) => ({ spec: r.id, warning: warning3 })))
  })).filter((g) => g.items.length > 0);
  const services = [...input.services ?? []].sort((a, b) => a.port - b.port).map((s) => s.label === null && labels.has(s.port) ? { ...s, label: labels.get(s.port) ?? null } : s);
  diagnostics.push(...input.sourceDiagnostics ?? []);
  return {
    kpis,
    stageCounts,
    specs: rows,
    nextUp: rows.filter((r) => r.nextCommand !== null).slice(0, NEXT_UP).map((r) => r.id),
    warningGroups,
    archive,
    brief,
    services,
    diagnostics,
    ideas: ideasOf(input.ideas)
  };
}
function ideasOf(files) {
  const list = readIdeas(files ?? {}).ideas.map(({ feature, milestone, slug, title, priority }) => ({ feature, milestone, slug, title, priority }));
  return { count: list.length, list };
}

// core/src/allocate.ts
function specNumbersOf(folders) {
  return folders.flatMap((name) => {
    const id = SPEC_FOLDER.exec(name)?.[1];
    return id === undefined ? [] : [Number(id)];
  });
}
function nextSpecNumber(taken) {
  let highest = 0;
  for (const n of taken)
    if (Number.isInteger(n) && n > highest)
      highest = n;
  return highest + 1;
}

// core/src/resolve.ts
import { readdirSync as readdirSync2 } from "fs";
import { join as join4, resolve as resolve3, sep } from "path";
function listSpecs(workspaceRoot) {
  return scan(workspaceRoot) ?? [];
}
function resolveSpec(workspaceRoot, ref) {
  const specs = scan(workspaceRoot);
  if (specs === null)
    return notFound(ref, "no-specs-dir");
  if (SPEC_ID.test(ref))
    return single(ref, specs.filter((s) => specIdOf(s.slug) === ref), "unknown-id");
  if (SPEC_FOLDER.test(ref)) {
    const byFolder2 = specs.filter((s) => s.slug === ref);
    if (byFolder2.length > 0)
      return single(ref, byFolder2, "unknown-slug");
  }
  return single(ref, specs.filter((s) => ref !== "" && specSlugOf(s.slug) === ref), "unknown-slug");
}
function single(ref, matches, missing) {
  if (matches.length === 0)
    return notFound(ref, missing);
  if (matches.length > 1)
    return notFound(ref, "ambiguous");
  return matches[0];
}
function notFound(ref, reason) {
  return { kind: "not_found", ref, reason };
}
function scan(workspaceRoot) {
  const specsDir = resolve3(workspaceRoot, "specs");
  const active = folders(specsDir);
  if (active === null)
    return null;
  const archiveDir = join4(specsDir, "archive");
  return [...refs(specsDir, active, false), ...refs(archiveDir, folders(archiveDir) ?? [], true)];
}
function refs(parent, names3, archived) {
  const out = [];
  for (const name of names3) {
    const match = SPEC_FOLDER.exec(name);
    if (match?.[1] === undefined)
      continue;
    out.push({ kind: "spec", id: match[1], slug: name, dir: join4(parent, name), archived });
  }
  return out.sort((a, b) => Number(a.id) - Number(b.id) || (a.slug < b.slug ? -1 : a.slug > b.slug ? 1 : 0));
}
function folders(dir) {
  let entries;
  try {
    entries = readdirSync2(dir, { withFileTypes: true });
  } catch (error) {
    const code = error.code;
    if (code === "ENOENT" || code === "ENOTDIR")
      return null;
    throw error;
  }
  return entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name);
}

// core/src/spec-text.ts
class SpecTextError extends Error {
  code;
  constructor(code, message) {
    super(message);
    this.name = "SpecTextError";
    this.code = code;
  }
}
var SECTIONS = {
  feature: ["Problem", "Vision", "Out of Scope", "Constraints", "Goal", "Not yet specified", "Claims", "Test Strategy", "Decisions", "Verification"],
  project: ["Problem", "Vision", "Out of Scope", "Principles", "Constraints", "Goal", "Not yet specified", "Claims", "Test Strategy", "Decisions", "Verification"],
  refactor: ["Problem", "Out of Scope", "Goal", "Claims", "Test Strategy", "Decisions", "Verification"],
  infra: ["Problem", "Constraints", "Goal", "Claims", "Test Strategy", "Decisions", "Verification"],
  spike: ["Problem", "Goal", "Not yet specified", "Claims", "Test Strategy", "Decisions", "Verification"],
  bug: ["Problem", "Goal", "Claims", "Test Strategy", "Decisions", "Verification"],
  chore: ["Problem", "Goal", "Claims", "Test Strategy", "Decisions", "Verification"]
};
var TABLE_HEAD = ["| isc | type | check | threshold | tool | anchors_to | severity |", "|-----|------|-------|-----------|------|------------|----------|"];
var LEVEL_TWO2 = /^##\s+(?!#)/;
var RULE2 = /^---\s*$/;
var HEADING_UP_TO_THREE = /^#{1,3}\s/;
var FENCE3 = /^\s*(```|~~~)/;
var ISC_NUMBER = /^ISC-(\d+)/;
var DATED = /^\d{4}-\d{2}-\d{2}\b/;
function linesOf(text2) {
  const eol = text2.includes(`\r
`) ? `\r
` : `
`;
  const lines = text2.split(/\r\n|\r|\n/);
  const fenced = [];
  let open = null;
  for (const line of lines) {
    const fence = FENCE3.exec(line)?.[1] ?? null;
    if (open === null && fence !== null) {
      open = fence;
      fenced.push(true);
    } else if (open !== null) {
      if (fence === open)
        open = null;
      fenced.push(true);
    } else {
      fenced.push(false);
    }
  }
  return { lines, fenced, eol };
}
function textOf(doc) {
  return doc.lines.join(doc.eol);
}
function insertBlock(doc, at, block) {
  const before = at > 0 && (doc.lines[at - 1] ?? "").trim() !== "" ? [""] : [];
  const after = at < doc.lines.length && (doc.lines[at] ?? "").trim() !== "" ? [""] : [];
  const added = [...before, ...block, ...after];
  doc.lines.splice(at, 0, ...added);
  doc.fenced.splice(at, 0, ...added.map(() => false));
}
function insertAfterLine(doc, anchor, block) {
  doc.lines.splice(anchor + 1, 0, ...block);
  doc.fenced.splice(anchor + 1, 0, ...block.map(() => false));
}
function sectionRange(doc, name) {
  const heading = new RegExp(String.raw`^##\s+${name}\s*$`, "i");
  const start = doc.lines.findIndex((l, i) => !doc.fenced[i] && heading.test(l));
  if (start < 0)
    return null;
  const end = doc.lines.findIndex((l, i) => i > start && !doc.fenced[i] && LEVEL_TWO2.test(l));
  return [start, end < 0 ? doc.lines.length : end];
}
function lastContent(doc, from, to) {
  for (let i = to - 1;i > from; i--)
    if ((doc.lines[i] ?? "").trim() !== "")
      return i;
  return from;
}
function appendToSection(doc, range, block, tight) {
  const last = lastContent(doc, range[0], range[1]);
  if (tight && last > range[0])
    insertAfterLine(doc, last, block);
  else
    insertBlock(doc, last + 1, block);
}
function newSectionAt(doc, beforeNames) {
  const found = beforeNames.map((n) => sectionRange(doc, n)?.[0]).filter((i) => i !== undefined);
  if (found.length > 0)
    return Math.min(...found);
  return doc.lines.length > 0 && doc.lines[doc.lines.length - 1] === "" ? doc.lines.length - 1 : doc.lines.length;
}
function afterSection(doc, name) {
  const range = sectionRange(doc, name);
  if (!range)
    return null;
  const end = range[1];
  return end === doc.lines.length && doc.lines[end - 1] === "" ? end - 1 : end;
}
function setKey(doc, key, value, insert) {
  if ((doc.lines[0] ?? "").replace(/^\uFEFF/, "").trim() !== "---")
    return;
  const close = doc.lines.findIndex((l, i) => i > 0 && l.trim() === "---");
  if (close < 0)
    return;
  const pattern = new RegExp(String.raw`^${key}\s*:`);
  let at = -1;
  for (let i = 1;i < close; i++)
    if (pattern.test(doc.lines[i] ?? ""))
      at = i;
  if (at >= 0)
    doc.lines[at] = `${key}: ${value}`;
  else if (insert) {
    doc.lines.splice(close, 0, `${key}: ${value}`);
    doc.fenced.splice(close, 0, false);
  }
}
function recount(doc, insert) {
  setKey(doc, "progress", formatProgress(parseClaims(textOf(doc)).counted), insert);
}
function oneLine2(value, what) {
  if (/[\r\n]/.test(value))
    throw new SpecTextError("multi-line", `${what} must be one line`);
  return value;
}
function validDate(now) {
  if (Number.isNaN(now.getTime()))
    throw new SpecTextError("bad-input", "the time is not a valid date");
  return now.toISOString();
}
function cell(value, what) {
  return oneLine2(value, what).trim().replace(/(?<!\\)\|/g, "\\|");
}
function claimLine2(id, claim) {
  const text2 = oneLine2(claim.text, `the text of ${id}`).trim();
  if (text2 === "")
    throw new SpecTextError("bad-input", `${id} has no text`);
  const after = claim.after ?? [];
  return `- [ ] ${id}: ${text2}${after.length > 0 ? ` (after: ${after.join(", ")})` : ""}`;
}
function rowLine(id, row) {
  const cells2 = [id, row.type, row.check, row.threshold, row.tool, row.anchorsTo].map((v) => cell(v, `a Test Strategy cell of ${id}`));
  const severity = cell(row.severity ?? "", `the severity of ${id}`);
  return `| ${[...cells2, severity].join(" | ")} |`;
}
function rowLines(ids, rows) {
  if (rows.length > ids.length)
    throw new SpecTextError("bad-input", `${rows.length} Test Strategy rows for ${ids.length} claims`);
  return rows.flatMap((row, i) => row ? [rowLine(ids[i] ?? "", row)] : []);
}
function claimSectionRange(doc, parsed) {
  if (!parsed.section)
    return null;
  const start = parsed.section.line - 1;
  const end = doc.lines.findIndex((l, i) => i > start && !doc.fenced[i] && (LEVEL_TWO2.test(l) || RULE2.test(l)));
  return [start, end < 0 ? doc.lines.length : end];
}
function insertClaims(doc, parsed, range, block, feature) {
  const inRange = parsed.claims.filter((c) => c.line - 1 > range[0] && c.line - 1 < range[1] && (feature === null || c.feature === feature));
  const lastClaim = inRange.reduce((max, c) => Math.max(max, c.line - 1), -1);
  if (lastClaim >= 0)
    insertAfterLine(doc, lastClaim, block);
  else
    appendToSection(doc, range, block, false);
}
function insertRows(doc, rows, claimSection) {
  if (rows.length === 0)
    return;
  const range = sectionRange(doc, "Test Strategy");
  if (range) {
    let lastRow = -1;
    for (let i = range[0] + 1;i < range[1]; i++)
      if (!doc.fenced[i] && /^\s*\|/.test(doc.lines[i] ?? ""))
        lastRow = i;
    if (lastRow >= 0)
      insertAfterLine(doc, lastRow, rows);
    else
      appendToSection(doc, range, [...TABLE_HEAD, ...rows], false);
    return;
  }
  const at = claimSection ? claimSection[1] : newSectionAt(doc, ["Decisions", "Changelog", "Verification"]);
  insertBlock(doc, at, ["## Test Strategy", "", ...TABLE_HEAD, ...rows]);
}
function mintClaimsText(master, feature, claims, rows, opts = {}) {
  if (claims.length === 0)
    throw new SpecTextError("bad-input", "no claim to mint");
  const parsed = parseClaims(master);
  const taken = new Set(parsed.claims.map((c) => c.id));
  let highest = 0;
  const bump = (id) => {
    const n = Number(ISC_NUMBER.exec(id)?.[1] ?? 0);
    if (n > highest)
      highest = n;
  };
  for (const c of parsed.claims)
    bump(c.id);
  for (const c of claims)
    if (c.id !== undefined)
      bump(c.id);
  const ids = claims.map((c) => {
    if (c.id === undefined) {
      highest += 1;
      return `ISC-${highest}`;
    }
    if (taken.has(c.id))
      throw new SpecTextError("duplicate-id", `the master already holds ${c.id}`);
    return c.id;
  });
  if (new Set(ids).size !== ids.length)
    throw new SpecTextError("duplicate-id", "two claims carry the same ID");
  const block = claims.map((c, i) => claimLine2(ids[i] ?? "", c));
  const newRows = rowLines(ids, rows);
  const doc = linesOf(master);
  const section3 = claimSectionRange(doc, parsed);
  if (!section3)
    throw new SpecTextError("no-claim-section", "the master has no claim section (## Features or ## Claims)");
  const target = parsed.features.find((f) => f.id === feature);
  if (target) {
    const head = target.line - 1;
    let end = doc.lines.findIndex((l, i) => i > head && !doc.fenced[i] && HEADING_UP_TO_THREE.test(l));
    if (end < 0 || end > section3[1])
      end = section3[1];
    insertClaims(doc, parsed, [head, end], block, feature);
  } else if (parsed.features.length === 0) {
    insertClaims(doc, parsed, section3, block, null);
  } else if (opts.featureName !== undefined) {
    const heading = `### ${feature} \xB7 ${oneLine2(opts.featureName, "the feature name").trim()}`;
    const why = opts.why === undefined ? [] : [`Why: ${oneLine2(opts.why, "the Why line").trim()}`];
    appendToSection(doc, section3, [heading, ...why, "", ...block], false);
  } else {
    throw new SpecTextError("unknown-feature", `the master has no feature block ${feature}`);
  }
  insertRows(doc, newRows, claimSectionRange(doc, parseClaims(textOf(doc))));
  recount(doc, true);
  return { text: textOf(doc), ids };
}
function projectClaimsText(spec, claims, rows) {
  if (claims.length === 0)
    throw new SpecTextError("bad-input", "no claim to project");
  const parsed = parseClaims(spec);
  const held = new Set(parsed.claims.map((c) => c.id));
  for (const c of claims)
    if (held.has(c.id))
      throw new SpecTextError("duplicate-id", `the spec already holds ${c.id}`);
  const ids = claims.map((c) => c.id);
  if (new Set(ids).size !== ids.length)
    throw new SpecTextError("duplicate-id", "two claims carry the same ID");
  const block = claims.map((c) => claimLine2(c.id, c));
  const newRows = rowLines(ids, rows);
  const doc = linesOf(spec);
  const section3 = claimSectionRange(doc, parsed);
  if (section3)
    insertClaims(doc, parsed, section3, block, null);
  else
    insertBlock(doc, newSectionAt(doc, ["Test Strategy", "Decisions", "Changelog", "Verification"]), ["## Claims", "", ...block]);
  insertRows(doc, newRows, claimSectionRange(doc, parseClaims(textOf(doc))));
  recount(doc, true);
  return textOf(doc);
}
function appendVerificationText(text2, id, type, stub, now) {
  oneLine2(stub, "the verification stub");
  oneLine2(type, "the verification type");
  if (stub.trim() === "")
    throw new SpecTextError("bad-input", "the verification stub is empty");
  const updated = validDate(now);
  const parsed = parseClaims(text2);
  const claim = parsed.claims.find((c) => c.id === id);
  if (!claim)
    throw new SpecTextError("unknown-id", `no claim line carries ${id}`);
  if (claim.dropped)
    throw new SpecTextError("dropped-claim", `${id} is dropped and takes no evidence`);
  const doc = linesOf(text2);
  const entry = `- ${id}: ${type.trim()} \u2014 ${stub.trim()}`;
  const range = sectionRange(doc, "Verification");
  if (range)
    appendToSection(doc, range, [entry], true);
  else
    insertBlock(doc, afterSection(doc, "Changelog") ?? afterSection(doc, "Decisions") ?? newSectionAt(doc, []), ["## Verification", "", entry]);
  const reparsed = parseClaims(textOf(doc)).claims.find((c) => c.id === id);
  const at = (reparsed?.line ?? claim.line) - 1;
  doc.lines[at] = (doc.lines[at] ?? "").replace(/^(\s*- \[) \]/, "$1x]");
  recount(doc, true);
  setKey(doc, "updated", updated, true);
  return textOf(doc);
}
function appendDecisionText(text2, line, now) {
  const body = oneLine2(line, "the decision").trim();
  if (body === "")
    throw new SpecTextError("bad-input", "the decision is empty");
  const updated = validDate(now);
  const entry = `- ${DATED.test(body) ? body : `${updated.slice(0, 10)}: ${body}`}`;
  const doc = linesOf(text2);
  const range = sectionRange(doc, "Decisions");
  if (range)
    appendToSection(doc, range, [entry], true);
  else
    insertBlock(doc, newSectionAt(doc, ["Changelog", "Verification"]), ["## Decisions", "", entry]);
  recount(doc, false);
  setKey(doc, "updated", updated, false);
  return textOf(doc);
}
function quoted(value) {
  return `"${value.replace(/\\/g, "\\\\").replace(/"/g, "\\\"")}"`;
}
function specFolderText(input) {
  const { type, number, slug, feature } = input;
  if (!SPEC_TYPES.includes(type))
    throw new SpecTextError("bad-input", `"${type}" is no spec type`);
  if (!Number.isInteger(number) || number < 1 || number > 999)
    throw new SpecTextError("bad-input", `spec number ${number} is outside 1 to 999`);
  if (!/^[a-z0-9][a-z0-9-]*$/.test(slug))
    throw new SpecTextError("bad-input", `"${slug}" is no kebab-case slug`);
  if (feature !== undefined && !/^F\d+(?:\.\d+)?$/.test(feature))
    throw new SpecTextError("bad-input", `"${feature}" is no feature block id`);
  const title = oneLine2(input.title, "the title").trim();
  const goal = input.goal.trim();
  if (title === "" || goal === "")
    throw new SpecTextError("bad-input", "the title and the goal must not be empty");
  if (input.actor.trim() === "")
    throw new SpecTextError("bad-input", "the actor must not be empty");
  const ts = validDate(input.now);
  const id = String(number).padStart(3, "0");
  const folder = `${id}-${slug}`;
  const frontmatter = [
    "---",
    `task: ${quoted(title)}`,
    `slug: ${folder}`,
    `spec_type: ${type}`,
    "isa_master: ../../ISA.md",
    ...feature === undefined ? [] : [`isa_feature: ${feature}`],
    "stage: plan",
    "phase: scoping",
    "progress: 0/0",
    `started: ${ts}`,
    `updated: ${ts}`,
    "context_log: context.md",
    "---"
  ];
  const owner = feature === undefined ? "" : ` (feature ${feature})`;
  const sections = SECTIONS[type].flatMap((name) => {
    if (name === "Goal")
      return [`## ${name}`, "", goal, ""];
    if (name === "Test Strategy")
      return [`## ${name}`, "", ...TABLE_HEAD, ""];
    return [`## ${name}`, ""];
  });
  const spec = [
    ...frontmatter,
    "",
    `<!-- SPEC \u2014 a derived view of ../../ISA.md${owner}. Claim IDs belong to the master: minted there first, then`,
    "     projected here. Never edit the master from this file. -->",
    "",
    `# ${id} \u2014 ${title}`,
    "",
    ...sections
  ].join(`
`);
  const context = [
    "---",
    `spec: ${folder}`,
    `created: ${ts}`,
    `updated: ${ts}`,
    "rounds: 0",
    "---",
    "",
    "<!-- CONTEXT LOG \u2014 a record, not an authority. Nothing here gates anything and nothing",
    "     reads it back. Every answer that changes the build lives in spec.md or plan.md. -->",
    "",
    `# Context ${id} \u2014 ${title}`,
    "",
    `## Goal \u2014 confirmed ${ts}`,
    "",
    goal,
    ""
  ].join(`
`);
  const event = { ts, from: null, to: "plan", command: `/spec new ${slug}`, actor: input.actor };
  return { dir: `specs/${folder}`, files: { "spec.md": spec, "context.md": context, "events.jsonl": `${JSON.stringify(event)}
` } };
}

// core/src/transition.ts
var CLOSE_PENDING_REASON = "every claim is closed and {feature} waits on {siblings}";
var STAGE_KEY = "stage:";
function laneOf(type, workflow) {
  if (type === null)
    return { type, stages: workflowStagesOf(null, workflow), codeReview: "spec" };
  const row = workflow.rows.find((r) => r.type === type) ?? defaultWorkflowRow(type);
  return { type, stages: row.stages, codeReview: row.codeReview };
}
function listed(lane, from, to) {
  const row = { type: lane.type ?? "feature", stages: lane.stages, codeReview: lane.codeReview };
  return rowTransitions(row).some((p) => p.from === from && p.to === to);
}
function moveAllowed(lane, from, to) {
  if (listed(lane, from, to))
    return true;
  return to === "close-pending" && lane.codeReview === "feature" && listed(lane, from, "code-review");
}
function phrase(stage, input) {
  const rule = ownRuleOf(stage);
  if (!rule)
    throw new Error(`SPEC_RULES has no row ${stage}`);
  const { form = 0, values = {} } = rule.explain(input);
  return fillReason(rule.reasons[form] ?? "", values);
}
function commandOf(stage, number) {
  const next = ownRuleOf(stage, true)?.next;
  return next === undefined || next === null ? null : commandWith(next, number);
}
var list = (ids) => ids.join(", ");
function gateRefusal(input, lane, from, stageInput, feature) {
  const { to, partition, featureSiblingsOpen: siblings } = input;
  const pastReview = to === "blocked" || to === "close-pending" || lane.stages.indexOf(to) > lane.stages.indexOf("review");
  if (pastReview && input.reviewed !== "fresh")
    return `${to} needs a fresh reviewed mark: ${phrase("review", stageInput)}`;
  const open = partition.takeable + partition.open;
  if ((to === "done" || to === "close" || to === "close-pending") && open > 0) {
    return `${to} needs every claim closed: ${phrase(partition.takeable > 0 ? "build" : "blocked", stageInput)}`;
  }
  if (to === "close-pending" && siblings.length === 0)
    return `close-pending needs an open sibling spec of ${feature}; none is open`;
  if (to === "code-review" && (lane.codeReview === "feature" || from === "close-pending") && siblings.length > 0) {
    const waits = open === 0 ? fillReason(CLOSE_PENDING_REASON, { feature, siblings: list(siblings) }) : `${feature} waits on ${list(siblings)}`;
    return `code-review is one review for ${feature}: ${waits}`;
  }
  return null;
}
function stageInputOf(input, fm, number) {
  const { texts } = input.files;
  const p = input.partition;
  const last = texts.events === undefined ? undefined : parseEvents(texts.events).events.at(-1);
  const lastTo = last?.to ?? null;
  const lastFrom = last?.from ?? null;
  return {
    number,
    type: fm.data.specType,
    phase: fm.data.phase,
    hasPlan: texts.plan !== undefined,
    hasTasks: texts.tasks !== undefined,
    claims: { closed: p.closed, total: p.takeable + p.open + p.closed },
    reviewed: input.reviewed,
    codeReviewed: input.codeReviewed ?? "missing",
    takeable: [],
    partition: p,
    explicitStage: fm.data.stage,
    lastEventTo: lastTo !== null && isWorkflowStage(lastTo) ? lastTo : null,
    lastEventFrom: lastFrom !== null && isWorkflowStage(lastFrom) ? lastFrom : null,
    workflow: input.workflow,
    codeReview: codeReviewOf(fm.data.specType, input.workflow),
    mainFeature: mainFeatureOf(fm.data.isaFeature),
    featureSiblingsOpen: input.featureSiblingsOpen,
    waits: input.waits ?? null,
    edgeHeld: input.edgeHeld ?? []
  };
}
function withStage(text2, stage, fm) {
  const lines = text2.split(`
`);
  const close = fm.bodyLine - 2;
  const cr = (line) => line?.endsWith("\r") ? "\r" : "";
  let at = -1;
  for (let i = 1;i < close; i++)
    if ((lines[i] ?? "").startsWith(STAGE_KEY))
      at = i;
  if (at >= 0)
    lines[at] = `stage: ${stage}${cr(lines[at])}`;
  else
    lines.splice(close, 0, `stage: ${stage}${cr(lines[close - 1])}`);
  const out = lines.join(`
`);
  const back = parseFrontmatter(out);
  return back.data.stage === stage && back.body === fm.body ? out : null;
}
function planTransition(input) {
  const { to, files } = input;
  const spec = files.texts.spec;
  if (spec === undefined)
    return { ok: false, from: "idea", to, reason: `${files.folder} has no spec.md`, command: null };
  const number = specIdOf(files.folder) ?? files.folder;
  const fm = parseFrontmatter(spec);
  const stageInput = stageInputOf(input, fm, number);
  const from = stageOf(stageInput);
  const refuse = (reason) => ({ ok: false, from, to, reason, command: nextCommandWithReason(stageInput).command });
  if (!fm.present)
    return refuse("spec.md has no frontmatter block to hold stage:");
  const lane = laneOf(fm.data.specType, input.workflow);
  if (from === to)
    return refuse(`the spec already stands in ${to}`);
  if (!moveAllowed(lane, from, to))
    return refuse(`the ${lane.type ?? "untyped"} workflow lists no move ${from} \u2192 ${to}`);
  const gate = gateRefusal(input, lane, from, stageInput, fm.data.isaFeature ?? "its main feature");
  if (gate !== null)
    return refuse(gate);
  const specText = withStage(spec, to, fm);
  if (specText === null)
    return refuse("spec.md does not read back with the new stage: line; its frontmatter is left as it is");
  const command = commandOf(from, number) ?? commandOf(to, number);
  if (command === null)
    return refuse(`no stage table command makes the move ${from} \u2192 ${to}`);
  if (Number.isNaN(input.now.getTime()))
    return refuse("the event time is not a valid date");
  const event = { ts: input.now.toISOString(), from, to, command, actor: input.actor };
  const checked = validateEventLine(JSON.stringify(event));
  if (!checked.ok)
    return refuse(`the event line would be rejected: ${checked.diagnostic.message}`);
  return { ok: true, from, to, specText, event };
}
function planCatchUp(input) {
  const { to, files } = input;
  const spec = files.texts.spec;
  if (spec === undefined)
    return { kind: "refused", from: "idea", to, reason: `${files.folder} has no spec.md`, command: null };
  const number = specIdOf(files.folder) ?? files.folder;
  const fm = parseFrontmatter(spec);
  const stageInput = stageInputOf(input, fm, number);
  const stands = stageOf(stageInput);
  const last = stageInput.lastEventTo;
  const refuse = (from, reason) => ({
    kind: "refused",
    from,
    to,
    reason,
    command: nextCommandWithReason(stageInput).command
  });
  if (stands !== to)
    return refuse(stands, `the files carry the spec to ${stands}, not ${to}`);
  if (last === to)
    return { kind: "recorded", stage: to };
  if (last === null)
    return refuse(stands, `no events.jsonl line records a stage to catch up from to ${to}`);
  if (!fm.present)
    return refuse(last, "spec.md has no frontmatter block to hold stage:");
  if (last === "review")
    return refuse(last, `the move review \u2192 ${to} is recorded by the reviewed mark's write, not caught up`);
  const lane = laneOf(fm.data.specType, input.workflow);
  if (!moveAllowed(lane, last, to)) {
    return refuse(last, `the files carry the spec to ${to}, but the ${lane.type ?? "untyped"} workflow lists no move ${last} \u2192 ${to} from the last recorded stage`);
  }
  const gate = gateRefusal(input, lane, last, stageInput, fm.data.isaFeature ?? "its main feature");
  if (gate !== null)
    return refuse(last, gate);
  const specText = withStage(spec, to, fm);
  if (specText === null)
    return refuse(last, "spec.md does not read back with the new stage: line; its frontmatter is left as it is");
  const command = commandOf(last, number) ?? commandOf(to, number);
  if (command === null)
    return refuse(last, `no stage table command makes the move ${last} \u2192 ${to}`);
  if (Number.isNaN(input.now.getTime()))
    return refuse(last, "the event time is not a valid date");
  const event = { ts: input.now.toISOString(), from: last, to, command, actor: input.actor };
  const checked = validateEventLine(JSON.stringify(event));
  if (!checked.ok)
    return refuse(last, `the event line would be rejected: ${checked.diagnostic.message}`);
  return { kind: "catch-up", from: last, to, specText, event };
}

// core/src/workflow.ts
var CODE_REVIEW_MODES = ["spec", "feature", "none"];
var ROW_STAGE = {
  idea: false,
  plan: true,
  tasks: true,
  review: true,
  build: true,
  blocked: false,
  "close-pending": false,
  "code-review": true,
  close: true,
  done: true
};
var FIXED_GATES = ["review", "build", "done"];
var knownStage = (stage) => Object.hasOwn(ROW_STAGE, stage);
function gateViolation(stages) {
  const foreign = stages.find((s) => !knownStage(s) || !ROW_STAGE[s]);
  if (foreign !== undefined) {
    return knownStage(foreign) ? `list ${foreign}, a detour no workflow row lists` : `list ${foreign}, a stage core does not know`;
  }
  const twice = stages.find((s, i) => stages.indexOf(s) !== i);
  if (twice !== undefined)
    return `list ${twice} twice`;
  const missing = FIXED_GATES.find((gate) => !stages.includes(gate));
  if (missing !== undefined)
    return `leave out the fixed gate ${missing}`;
  if (stages.indexOf("review") > stages.indexOf("build"))
    return "put the fixed gate review after build";
  const last = stages.at(-1) ?? "";
  if (last !== "done")
    return `list ${last} after the fixed gate done`;
  return null;
}
var HEADER = ["type", "stages", "code_review"];
var FENCE4 = /^\s*(```|~~~)/;
var plain = (cell2) => cell2.replace(/`/g, "").trim();
function parseWorkflow(text2) {
  if (text2 === null)
    return { rows: DEFAULT_WORKFLOW, source: "default", diagnostics: [] };
  const diagnostics = [];
  const warn = (code, message, line, subject) => {
    diagnostics.push(subject === undefined ? { severity: "warning", code, message, line } : { severity: "warning", code, message, line, subject });
  };
  const lines = text2.replace(/\r\n?/g, `
`).split(`
`);
  const header = findHeader(lines);
  const byType = new Map;
  if (header === null) {
    warn("workflow-table", "specs/workflow.md has no table | type | stages | code_review |; every type runs its default row.", 1);
  } else if (!TABLE_SEP.test(lines[header + 1] ?? "")) {
    warn("workflow-table", "the workflow table has no separator row under its header; every type runs its default row.", header + 1);
  } else {
    for (let i = header + 2;i < lines.length && /^\s*\|/.test(lines[i] ?? ""); i++) {
      const parsed = parseRow(lines[i] ?? "", i + 1, warn);
      if (parsed)
        byType.set(parsed.row.type, [...byType.get(parsed.row.type) ?? [], parsed]);
    }
  }
  const rows = WORKFLOW_TYPES.map((type) => {
    const found = byType.get(type) ?? [];
    for (const dup of found.slice(1)) {
      warn("workflow-duplicate", `type ${type} has more than one row; it runs its default row.`, dup.line, type);
    }
    const only = found.length === 1 ? found[0] : undefined;
    if (!only)
      return defaultWorkflowRow(type);
    const violation = gateViolation(only.row.stages);
    if (violation === null)
      return only.row;
    warn("workflow-gate", `the stages of type ${type} ${violation}; it runs its default row.`, only.line, type);
    return defaultWorkflowRow(type);
  });
  diagnostics.sort((a, b) => (a.line ?? 0) - (b.line ?? 0));
  return { rows, source: "file", diagnostics };
}
function findHeader(lines) {
  let fenced = false;
  for (let i = 0;i < lines.length; i++) {
    const line = lines[i] ?? "";
    if (FENCE4.test(line))
      fenced = !fenced;
    else if (!fenced && /^\s*\|/.test(line) && tableCells2(line).map((c) => plain(c).toLowerCase()).join("|") === HEADER.join("|"))
      return i;
  }
  return null;
}
function parseRow(text2, line, warn) {
  const cells2 = tableCells2(text2).map(plain);
  if (cells2.length !== HEADER.length) {
    warn("workflow-row", `a workflow row needs the three cells type, stages and code_review; it has ${cells2.length}.`, line);
    return null;
  }
  const [typeCell = "", stagesCell = "", modeCell = ""] = cells2;
  const type = WORKFLOW_TYPES.find((t) => t === typeCell);
  if (!type) {
    warn("workflow-type", `type ${typeCell} is none of ${WORKFLOW_TYPES.join(", ")}; the row is ignored.`, line, typeCell);
    return null;
  }
  const stages = stagesCell.split("\xB7").map((s) => s.trim());
  if (stages.some((s) => s === "")) {
    warn("workflow-row", `the stages of type ${type} hold an empty stage; it runs its default row.`, line, type);
    return null;
  }
  const codeReview = CODE_REVIEW_MODES.find((m) => m === modeCell);
  if (!codeReview) {
    warn("workflow-code-review", `code_review ${modeCell} of type ${type} is none of ${CODE_REVIEW_MODES.join(", ")}; it runs its default row.`, line, modeCell);
    return null;
  }
  return { row: { type, stages, codeReview }, line };
}

// plugin/src/spec-check.ts
var EXIT = { ok: 0, badArgs: 1, drift: 3, lockLost: 4 };

class CliError extends Error {
  exit;
  constructor(exit, message) {
    super(message);
    this.name = "CliError";
    this.exit = exit;
  }
}
var bad = (message) => new CliError(EXIT.badArgs, message);
var COMMON_FLAGS = ["json", "help"];
function parseArgs(argv, valueNames, flagNames) {
  const positional = [];
  const values = new Map;
  const lists = new Map;
  const flags = new Set;
  for (let i = 0;i < argv.length; i += 1) {
    const arg = argv[i] ?? "";
    if (!arg.startsWith("--") || arg === "--") {
      positional.push(arg);
      continue;
    }
    const eq = arg.indexOf("=");
    const name = arg.slice(2, eq < 0 ? undefined : eq);
    if ([...COMMON_FLAGS, ...flagNames].includes(name)) {
      if (eq >= 0)
        throw bad(`--${name} takes no value`);
      flags.add(name);
    } else if (valueNames.includes(name)) {
      const value = eq >= 0 ? arg.slice(eq + 1) : argv[i += 1];
      if (value === undefined)
        throw bad(`--${name} needs a value`);
      values.set(name, value);
      lists.set(name, [...lists.get(name) ?? [], value]);
    } else {
      throw bad(`unknown option --${name}`);
    }
  }
  return { positional, values, lists, flags };
}
function required(args, index, what) {
  const value = args.positional[index];
  if (value === undefined || value === "")
    throw bad(`missing ${what}`);
  return value;
}
function git(cwd, args) {
  const r = Bun.spawnSync(["git", ...args], { cwd, stdout: "pipe", stderr: "pipe", env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" } });
  return r.exitCode === 0 ? r.stdout.toString() : null;
}
function readIfExists2(path) {
  try {
    return readFileSync3(path, "utf8");
  } catch (error) {
    if (error.code === "ENOENT")
      return null;
    throw error;
  }
}
var FOLDER_KINDS = Object.keys(FILE_KINDS).filter((kind) => !FILE_KINDS[kind].directory && !FILE_KINDS[kind].path.startsWith(".."));
function specFiles(ref) {
  const texts = {};
  for (const kind of FOLDER_KINDS) {
    const text2 = readIfExists2(join5(ref.dir, FILE_KINDS[kind].path));
    if (text2 !== null)
      texts[kind] = text2;
  }
  return { folder: ref.slug, texts };
}
function specRef(root, arg) {
  const name = basename(arg.replace(/[\\/]+$/u, ""));
  const ref = resolveSpec(root, name);
  if (ref.kind === "not_found")
    throw bad(`no spec folder matches "${arg}" (${ref.reason})`);
  return ref;
}
var rel = (ctx, path) => relative(ctx.root, path).split(sep2).join("/");
function specText(ctx, ref) {
  const text2 = readIfExists2(join5(ref.dir, "spec.md"));
  if (text2 === null)
    throw bad(`${rel(ctx, ref.dir)} has no spec.md`);
  return text2;
}
var masterPath = (ctx) => join5(ctx.root, "ISA.md");
async function locksOf(ctx) {
  return readLockSources({ repoRoot: ctx.root });
}
function emit(ctx, args, value, lines) {
  ctx.out(args.flags.has("json") ? JSON.stringify(value, null, 2) : lines.join(`
`));
}
function titleOf(slug) {
  const words = slug.replace(/-+/gu, " ").trim();
  return words.charAt(0).toUpperCase() + words.slice(1);
}
function branchNumbers(root) {
  const names3 = (git(root, ["branch", "-a", "--format=%(refname:short)"]) ?? "").split(`
`);
  return specNumbersOf(names3.flatMap((name) => name.trim().split("/").slice(1)));
}
function allocate(ctx, args) {
  const type = required(args, 0, "the spec type");
  const slug = required(args, 1, "the slug");
  if (!SPEC_TYPES.includes(type))
    throw bad(`"${type}" is no spec type (${SPEC_TYPES.join(", ")})`);
  const listed2 = listSpecs(ctx.root);
  const clash = listed2.find((s) => specSlugOf(s.slug) === slug);
  if (clash)
    throw bad(`a spec folder for "${slug}" exists already: ${rel(ctx, clash.dir)}`);
  const number = nextSpecNumber([...specNumbersOf(listed2.map((s) => s.slug)), ...branchNumbers(ctx.root)]);
  const title = args.values.get("title") ?? titleOf(slug);
  const goal = args.values.get("goal");
  const feature = args.values.get("feature");
  const plan = specFolderText({
    type,
    number,
    slug,
    title,
    goal: goal ?? title,
    ...feature === undefined ? {} : { feature },
    now: ctx.now,
    actor: args.values.get("actor") ?? "a:claude:spec-check"
  });
  const dir = join5(ctx.root, ...plan.dir.split("/"));
  if (existsSync(dir))
    throw bad(`${plan.dir} exists already`);
  mkdirSync3(dir, { recursive: true });
  const files = Object.keys(plan.files);
  for (const name of files)
    writeFileSync2(join5(dir, name), plan.files[name]);
  emit(ctx, args, { dir: plan.dir, number, files }, [
    `allocated ${plan.dir} (${files.join(", ")})`,
    ...goal === undefined ? ["no --goal given: the goal reads as the title; confirm it in spec.md and context.md"] : []
  ]);
  return EXIT.ok;
}
var isRecord5 = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var isString = (v) => typeof v === "string";
function claimInputs(path) {
  const text2 = readIfExists2(path);
  if (text2 === null)
    throw bad(`the claims file ${basename(path)} does not exist`);
  let data;
  try {
    data = JSON.parse(text2);
  } catch {
    throw bad(`the claims file ${basename(path)} is not valid JSON`);
  }
  if (!Array.isArray(data) || data.length === 0)
    throw bad("the claims file must hold a non-empty JSON array");
  return data.map((item, i) => {
    const at = `claim ${i + 1}`;
    if (!isRecord5(item) || !isString(item.text))
      throw bad(`${at}: needs a "text" string`);
    if (item.id !== undefined && !isString(item.id))
      throw bad(`${at}: "id" must be a string`);
    if (item.after !== undefined && !(Array.isArray(item.after) && item.after.every(isString)))
      throw bad(`${at}: "after" must be a list of claim IDs`);
    const claim = { text: item.text, ...isString(item.id) ? { id: item.id } : {}, ...Array.isArray(item.after) ? { after: item.after } : {} };
    if (item.row === undefined || item.row === null)
      return { claim, row: null };
    const r = item.row;
    if (!isRecord5(r) || ![r.type, r.check, r.threshold, r.tool, r.anchorsTo].every(isString)) {
      throw bad(`${at}: "row" needs the strings type, check, threshold, tool and anchorsTo`);
    }
    if (r.severity !== undefined && !isString(r.severity))
      throw bad(`${at}: "row.severity" must be a string`);
    const row = {
      type: r.type,
      check: r.check,
      threshold: r.threshold,
      tool: r.tool,
      anchorsTo: r.anchorsTo,
      ...isString(r.severity) ? { severity: r.severity } : {}
    };
    return { claim, row };
  });
}
var ISC_NUMBER2 = /^ISC-(\d+)/u;
function nextIdAcrossSpecs(root) {
  let highest = 0;
  for (const ref of listSpecs(root)) {
    const text2 = readIfExists2(join5(ref.dir, "spec.md"));
    if (text2 === null)
      continue;
    for (const c of parseClaims(text2).claims)
      highest = Math.max(highest, Number(ISC_NUMBER2.exec(c.id)?.[1] ?? 0));
  }
  return highest + 1;
}
function mint(ctx, args) {
  const ref = specRef(ctx.root, required(args, 0, "the spec"));
  const feature = args.values.get("feature");
  if (feature === undefined || !/^F\d+(?:\.\d+)?$/u.test(feature))
    throw bad("--feature F<n> is required");
  const claimsFile = args.values.get("claims");
  if (claimsFile === undefined)
    throw bad("--claims <json-file> is required");
  const inputs = claimInputs(resolve4(ctx.cwd, claimsFile));
  const claims = inputs.map((i) => i.claim);
  const rows = inputs.map((i) => i.row);
  const featureName = args.values.get("feature-name");
  const why = args.values.get("why");
  const specPath = join5(ref.dir, "spec.md");
  const spec = specText(ctx, ref);
  const master = readIfExists2(masterPath(ctx));
  if (master === null) {
    let next = nextIdAcrossSpecs(ctx.root);
    const numbered = claims.map((c) => c.id === undefined ? { ...c, id: `ISC-${next++}` } : c);
    const planned = mintClaimsText(spec, feature, numbered, rows);
    writeFileSync2(specPath, planned.text);
    emit(ctx, args, { ids: planned.ids, master: false, spec: rel(ctx, specPath) }, [
      `minted ${planned.ids.join(", ")} into ${rel(ctx, specPath)}`,
      "no master ISA.md in this repository: the claims went into the spec only"
    ]);
    return EXIT.ok;
  }
  const minted = mintClaimsText(master, feature, claims, rows, {
    ...featureName === undefined ? {} : { featureName },
    ...why === undefined ? {} : { why }
  });
  const projected = projectClaimsText(spec, claims.map((c, i) => ({ ...c, id: minted.ids[i] ?? "" })), rows);
  writeFileSync2(masterPath(ctx), minted.text);
  writeFileSync2(specPath, projected);
  emit(ctx, args, { ids: minted.ids, master: true, spec: rel(ctx, specPath) }, [
    `minted ${minted.ids.join(", ")} into ISA.md (${feature}), then projected them into ${rel(ctx, specPath)}`
  ]);
  return EXIT.ok;
}
function verify(ctx, args) {
  const ref = specRef(ctx.root, required(args, 0, "the spec"));
  const id = required(args, 1, "the claim ID");
  const type = required(args, 2, "the verification type");
  const stub = required(args, 3, "the one-line stub");
  const specPath = join5(ref.dir, "spec.md");
  const nextSpec = appendVerificationText(specText(ctx, ref), id, type, stub, ctx.now);
  const master = readIfExists2(masterPath(ctx));
  let nextMaster = null;
  if (master !== null) {
    if (!parseClaims(master).claims.some((c) => c.id === id)) {
      throw new CliError(EXIT.drift, `the master ISA.md holds no ${id}; nothing written \u2014 run spec-check drift`);
    }
    nextMaster = appendVerificationText(master, id, type, stub, ctx.now);
  }
  writeFileSync2(specPath, nextSpec);
  if (nextMaster !== null)
    writeFileSync2(masterPath(ctx), nextMaster);
  const files = [rel(ctx, specPath), ...nextMaster === null ? [] : ["ISA.md"]];
  emit(ctx, args, { id, files }, [`verified ${id} in ${files.join(" and ")}`]);
  return EXIT.ok;
}
function decisionFile(ctx, arg) {
  for (const candidate of [resolve4(ctx.cwd, arg), resolve4(ctx.root, arg)]) {
    if (!existsSync(candidate) || !statSync(candidate).isFile())
      continue;
    const inside = relative(ctx.root, candidate);
    if (inside.startsWith("..") || resolve4(ctx.root, inside) !== candidate)
      throw bad(`${arg} lies outside the repository`);
    return candidate;
  }
  return join5(specRef(ctx.root, arg).dir, "spec.md");
}
function decide(ctx, args) {
  const path = decisionFile(ctx, required(args, 0, "the file"));
  const line = required(args, 1, "the decision line");
  const text2 = readIfExists2(path);
  if (text2 === null)
    throw bad(`${rel(ctx, path)} does not exist`);
  writeFileSync2(path, appendDecisionText(text2, line, ctx.now));
  emit(ctx, args, { file: rel(ctx, path) }, [`decision added to ${rel(ctx, path)}`]);
  return EXIT.ok;
}
function idsOf(text2) {
  return new Set(text2 === null ? [] : parseClaims(text2).claims.map((c) => c.id));
}
function driftLines(slug, report) {
  const lines = [];
  for (const [name, value] of Object.entries(report)) {
    if (Array.isArray(value) && value.length > 0)
      lines.push(`  ${name}: ${value.map((v) => isRecord5(v) ? JSON.stringify(v) : String(v)).join(", ")}`);
    else if (isRecord5(value))
      lines.push(`  ${name}: ${JSON.stringify(value)}`);
    else if (typeof value === "number" && value > 0)
      lines.push(`  ${name}: ${value}`);
  }
  return lines.length === 0 ? [] : [`${slug}:`, ...lines];
}
function drift(ctx, args) {
  const listed2 = listSpecs(ctx.root);
  const one = args.positional[0];
  const targets = one === undefined ? listed2.filter((s) => !s.archived) : [specRef(ctx.root, one)];
  const master = readIfExists2(masterPath(ctx));
  const masterDoc = master === null ? null : parseClaims(master);
  const held = new Map(listed2.map((s) => [s.slug, idsOf(readIfExists2(join5(s.dir, "spec.md")))]));
  const specs = [];
  for (const ref of targets) {
    const text2 = readIfExists2(join5(ref.dir, "spec.md"));
    if (text2 === null)
      continue;
    const heldElsewhere2 = new Set([...held].filter(([slug]) => slug !== ref.slug).flatMap(([, ids]) => [...ids]));
    const report = driftReport({ frontmatter: parseFrontmatter(text2), spec: parseClaims(text2), master: masterDoc, heldElsewhere: heldElsewhere2 });
    specs.push({ id: ref.id, slug: ref.slug, drift: hasDrift(report), report });
  }
  const masterProgress = master === null || masterDoc === null || one !== undefined ? null : masterProgressMismatch(parseFrontmatter(master), masterDoc);
  const any = masterProgress !== null || specs.some((s) => s.drift);
  const lines = specs.flatMap((s) => driftLines(s.slug, s.report));
  if (masterProgress !== null)
    lines.push(`ISA.md: progress ${masterProgress.declared ?? "missing"}, counted ${masterProgress.counted}`);
  if (master === null)
    lines.push("no master ISA.md: claim IDs are not checked against a master");
  emit(ctx, args, { drift: any, master: master !== null, masterProgress, specs }, any ? lines : [`drift: none (${specs.length} spec${specs.length === 1 ? "" : "s"})`, ...lines]);
  return any ? EXIT.drift : EXIT.ok;
}
function partitionView(p) {
  return { closed: p.closed, open: p.open, takeable: p.takeable, gated: p.gated, blocked: p.blocked, taken: p.taken, dropped: p.dropped };
}
function worktreeTreeOf(ctx, specs) {
  if (!specs.some((f) => f.texts.gateCodeReviewed !== undefined))
    return null;
  return checkoutOf(ctx.cwd)?.tree ?? null;
}
function dashboardInput(ctx, locks) {
  const listed2 = listSpecs(ctx.root);
  const specs = listed2.filter((s) => !s.archived).map(specFiles);
  return {
    master: readIfExists2(masterPath(ctx)),
    constitution: readIfExists2(join5(ctx.root, "specs", "constitution.md")),
    tldr: readIfExists2(join5(ctx.root, "specs", "tldr.md")),
    specs,
    archived: listed2.filter((s) => s.archived).map(specFiles),
    worktreeTree: worktreeTreeOf(ctx, specs),
    locks,
    workflow: parseWorkflow(readIfExists2(join5(ctx.root, "specs", "workflow.md")))
  };
}
async function status(ctx, args) {
  const one = args.positional[0] === undefined ? null : specRef(ctx.root, args.positional[0]);
  if (one?.archived)
    throw bad(`${rel(ctx, one.dir)} is archived`);
  const locks = await locksOf(ctx);
  const input = dashboardInput(ctx, locks);
  const active = input.specs;
  const model = buildDashboard(input);
  const rows = model.specs.filter((row) => one === null || row.slug === one.slug);
  const specs = rows.map((row) => {
    const texts = active.find((f) => f.folder === row.slug)?.texts ?? {};
    const reviewed = reviewedGate(texts).check.state;
    const partition = partitionClaims(parseClaims(texts.spec ?? "").claims, locks.locks, reviewed);
    return {
      id: row.id,
      slug: row.slug,
      title: row.title,
      type: row.type,
      phase: row.phase,
      stage: row.stage,
      progress: `${row.progress.closed}/${row.progress.total}`,
      tasks: row.tasks,
      reviewed,
      next: row.nextCommand,
      reason: row.nextReason,
      partition: partitionView(partition)
    };
  });
  const lines = specs.map((s) => `${s.slug}  ${s.stage}  ${s.phase ?? "-"}  ${s.progress}${s.next === null ? "" : `  next: ${s.next} (${s.reason})`}`);
  emit(ctx, args, { specs }, lines.length === 0 ? ["no specs"] : lines);
  return EXIT.ok;
}
async function frontier(ctx, args) {
  const ref = specRef(ctx.root, required(args, 0, "the spec"));
  const files = specFiles(ref);
  const text2 = files.texts.spec;
  if (text2 === undefined)
    throw bad(`${rel(ctx, ref.dir)} has no spec.md`);
  const claims = [...parseClaims(text2).claims];
  const reviewed = reviewedGate(files.texts).check.state;
  const locks = (await locksOf(ctx)).locks;
  const constitution = readIfExists2(join5(ctx.root, "specs", "constitution.md"));
  const tasks = files.texts.tasks === undefined ? null : parseTaskLines({
    tasks: files.texts.tasks,
    ...constitution === null ? {} : { constitution },
    ...files.texts.rounds === undefined ? {} : { rounds: files.texts.rounds }
  });
  const partition = partitionClaims(claims, locks, reviewed);
  const set = takeableSet({ specType: parseFrontmatter(text2).data.specType, claims, tasks, locks, reviewed, partition });
  const value = {
    spec: ref.slug,
    reviewed,
    takeable: set.claims,
    gated: partition.gated,
    blocked: partition.blocked,
    taken: partition.taken,
    width: set.width,
    dispatch: set.dispatch,
    held: set.held,
    tasks: set.tasks,
    exhausted: set.exhausted
  };
  const lines = [
    `${ref.slug}: reviewed ${reviewed}; takeable ${set.claims.length === 0 ? "none" : set.claims.join(", ")}`,
    ...set.dispatch.map((d) => `  dispatch ${d.task} (${d.claim}): ${d.reason}`),
    ...set.held.map((h) => `  held ${h.task} (${h.claim}): ${h.reason}`)
  ];
  emit(ctx, args, value, lines);
  return EXIT.ok;
}
var SUBCOMMAND_OF = {
  "/spec-plan": "plan",
  "/spec-tasks": "tasks",
  "/spec-review": "review",
  "/spec-implement": "implement",
  "/spec-status": "implement",
  "/spec-code-review": "review",
  "/spec-complete": "done"
};
function pluginCommand(command) {
  const [head = "", ...rest] = command.split(" ");
  const sub = SUBCOMMAND_OF[head];
  return sub === undefined ? command : ["/spec", sub, ...rest].join(" ");
}
function holdsFeatureOpen2(files) {
  const spec = files.texts.spec;
  if (spec === undefined)
    return false;
  return parseFrontmatter(spec).data.phase !== "complete" && parseClaims(spec).claims.some((c) => !c.checked && !c.dropped);
}
function transitionInput(ctx, ref, to, actor, locks) {
  const listed2 = listSpecs(ctx.root);
  const active = listed2.filter((s) => !s.archived).map(specFiles);
  const archived = listed2.filter((s) => s.archived).map(specFiles);
  const files = active.find((f) => f.folder === ref.slug) ?? specFiles(ref);
  const spec = files.texts.spec ?? "";
  const id = specIdOf(files.folder) ?? files.folder;
  const reviewed = reviewedGate(files.texts).check.state;
  const partition = partitionClaims(parseClaims(spec).claims, locks.locks, reviewed);
  const codeMark = files.texts.gateCodeReviewed === undefined ? null : readGateMark("code-reviewed", files.texts.gateCodeReviewed).mark;
  const edges = resolveEdges({ specs: active, archived, constitution: readIfExists2(join5(ctx.root, "specs", "constitution.md")) }, []);
  const edgeHeld = specEdgeHolds(partition.takeable, edges.edges.filter((e) => e.fromSpec === id));
  const takeable = partition.takeable.filter((c) => !edgeHeld.has(c));
  const feature = mainFeatureOf(parseFrontmatter(spec).data.isaFeature);
  const siblings = feature === null ? [] : active.filter((f) => f.texts.spec !== undefined && mainFeatureOf(parseFrontmatter(f.texts.spec).data.isaFeature) === feature && holdsFeatureOpen2(f)).map((f) => specIdOf(f.folder) ?? f.folder).filter((sibling) => sibling !== id).sort();
  return {
    files,
    workflow: parseWorkflow(readIfExists2(join5(ctx.root, "specs", "workflow.md"))),
    to,
    actor,
    now: ctx.now,
    reviewed,
    codeReviewed: gateState("code-reviewed", codeMark, { worktreeTree: worktreeTreeOf(ctx, [files]) }).state,
    partition: {
      takeable: takeable.length,
      open: partition.open.length - takeable.length,
      closed: partition.closed.length - partition.dropped.length,
      dropped: partition.dropped.length
    },
    featureSiblingsOpen: siblings,
    waits: edges.waits.find((w) => w.spec === id) ?? null,
    edgeHeld: [...new Set([...edgeHeld.values()].flat())].sort()
  };
}
function refusal(ref, plan) {
  const next = plan.command === null ? "" : `; next: ${pluginCommand(plan.command)}`;
  return new CliError(EXIT.drift, `${ref.slug} stays in ${plan.from}: ${plan.reason}${next}; nothing written`);
}
async function transition(ctx, args) {
  const ref = specRef(ctx.root, required(args, 0, "the spec"));
  const to = required(args, 1, "the target stage");
  if (!isWorkflowStage(to))
    throw bad(`"${to}" is no stage (${WORKFLOW_STAGES.join(", ")})`);
  specText(ctx, ref);
  const actor = args.values.get("actor") ?? "a:claude:spec-check";
  const input = transitionInput(ctx, ref, to, actor, await locksOf(ctx));
  const direct = planTransition(input);
  let plan;
  if (direct.ok)
    plan = direct;
  else if (direct.from !== to)
    throw refusal(ref, direct);
  else {
    const late = planCatchUp(input);
    if (late.kind === "refused")
      throw refusal(ref, late);
    if (late.kind === "recorded") {
      emit(ctx, args, { spec: ref.slug, from: to, to, event: null, already: true }, [`${ref.slug}: already there (${to}); nothing written`]);
      return EXIT.ok;
    }
    plan = late;
  }
  const event = { ...plan.event, command: args.values.get("command") ?? pluginCommand(plan.event.command) };
  const line = checkedEvent(event);
  writeFileSync2(join5(ref.dir, "spec.md"), plan.specText);
  appendEventLine(ref.dir, line);
  emit(ctx, args, { spec: ref.slug, from: plan.from, to: plan.to, event }, [`${ref.slug}: ${plan.from} \u2192 ${plan.to} (${event.command})`]);
  return EXIT.ok;
}
var CLI_SESSION = "a:claude:spec-check";
var activityText = (ctx) => readActivity2(ctx.root);
function requiredValue(args, name, what) {
  const value = args.values.get(name);
  if (value === undefined || value === "")
    throw bad(`--${name} ${what} is required`);
  return value;
}
function startedRunIds(text2) {
  const ids = new Set;
  for (const raw of text2.split(`
`)) {
    if (raw.trim() === "")
      continue;
    try {
      const line = JSON.parse(raw);
      if (isRecord5(line) && line.event === "run-start" && isString(line.run))
        ids.add(line.run);
    } catch {}
  }
  return ids;
}
function runStart(ctx, args) {
  const target = basename(required(args, 1, "the target (NNN, NNN-slug, an idea slug or init)").replace(/[\\/]+$/u, ""));
  const command = requiredValue(args, "command", '"<the command as typed>"');
  const session = args.values.get("session") ?? CLI_SESSION;
  const ts = ctx.now.toISOString();
  const run = newRunId({ ts, session, command, target });
  const line = runStartLine({ run, target, command, session, ts });
  if (startedRunIds(activityText(ctx)).has(run))
    throw bad(`the run ${run} was started already; nothing written`);
  appendActivity(ctx.root, line);
  emit(ctx, args, { run, target, command, session }, [run]);
  return EXIT.ok;
}
function runEnd(ctx, args) {
  const run = required(args, 1, "the run id");
  const outcome = requiredValue(args, "outcome", "ok|error");
  if (outcome !== "ok" && outcome !== "error")
    throw bad(`the outcome "${outcome}" is neither ok nor error`);
  const open = (activityReading(activityText(ctx)).openRuns ?? []).find((r) => r.run === run);
  if (open === undefined)
    throw bad(`no open run ${run} in .spectant/activity.jsonl (unknown or ended already); nothing written`);
  const session = args.values.get("session") ?? open.session;
  const target = open.spec ?? open.idea ?? "";
  const ended = outcome;
  const line = runEndLine({ run, target, command: open.command, session, ts: ctx.now.toISOString(), outcome: ended });
  appendActivity(ctx.root, line);
  emit(ctx, args, { run, target, command: open.command, session, outcome }, [`${run} ended (${outcome})`]);
  return EXIT.ok;
}
function runCommand(ctx, args) {
  const sub = required(args, 0, "start or end");
  if (sub === "start")
    return runStart(ctx, args);
  if (sub === "end")
    return runEnd(ctx, args);
  throw bad(`"${sub}" is neither start nor end`);
}
function lockInput(ctx, args) {
  const claim = required(args, 0, "the claim ID");
  const session = requiredValue(args, "session", "<actor>");
  const task = args.values.get("task");
  const worktree = args.values.get("worktree");
  return { claim, session, ts: ctx.now.toISOString(), ...task === undefined ? {} : { task }, ...worktree === undefined ? {} : { worktree } };
}
function lockClaim(ctx, args) {
  const input = lockInput(ctx, args);
  const outcome = appendClaim(ctx.root, input);
  if (outcome.done === "other")
    throw new CliError(EXIT.lockLost, `lock held: ${input.claim} is held by ${String(outcome.holder)}; nothing written`);
  if (outcome.done === "held") {
    emit(ctx, args, { claim: input.claim, session: input.session, already: true }, [`${input.claim}: held by ${input.session} already; nothing written`]);
    return EXIT.ok;
  }
  emit(ctx, args, { claim: input.claim, session: input.session, already: false }, [`${input.claim}: claimed by ${input.session}`]);
  return EXIT.ok;
}
function lockRelease(ctx, args) {
  const input = lockInput(ctx, args);
  const outcome = appendRelease(ctx.root, input);
  if (outcome.done === "held") {
    emit(ctx, args, { claim: input.claim, session: input.session, released: false }, [`${input.claim}: not held; nothing written`]);
    return EXIT.ok;
  }
  if (outcome.done === "other")
    throw new CliError(EXIT.lockLost, `lock lost: ${input.claim} is held by ${String(outcome.holder)}, not ${input.session}; nothing written`);
  emit(ctx, args, { claim: input.claim, session: input.session, released: true }, [`${input.claim}: released by ${input.session}`]);
  return EXIT.ok;
}
var STEP_EVENTS = ["dispatch", "build", "patch", "apply"];
function activity(ctx, args) {
  const event = required(args, 0, "the event (dispatch, build, patch, apply, probe or question)");
  const task = requiredValue(args, "task", "T<k>");
  const session = requiredValue(args, "session", "<actor>");
  const claim = args.values.get("claim");
  const worktree = args.values.get("worktree");
  const common = { task, session, ts: ctx.now.toISOString(), ...worktree === undefined ? {} : { worktree } };
  const withClaim = claim === undefined ? {} : { claim };
  let line;
  if (event === "probe") {
    const result = args.values.get("result");
    if (result !== "red" && result !== "green")
      throw bad("a probe needs --result red|green");
    line = probeLine({ ...common, claim: requiredValue(args, "claim", "ISC-N"), result });
    appendActivity(ctx.root, line);
  } else if (event === "question") {
    line = questionLine({ ...common, ...withClaim, text: requiredValue(args, "text", '"<the question>"') });
    appendActivity(ctx.root, line);
  } else if (STEP_EVENTS.includes(event)) {
    line = appendRunEvent(ctx.root, { ...common, ...withClaim, event });
  } else {
    throw bad(`"${event}" is none of dispatch, build, patch, apply, probe or question`);
  }
  emit(ctx, args, JSON.parse(line), [`${event} ${task}${claim === undefined ? "" : ` (${claim})`} appended to .spectant/activity.jsonl`]);
  return EXIT.ok;
}
async function hook(ctx) {
  let stdin = "";
  try {
    stdin = await Bun.stdin.text();
  } catch {
    return EXIT.ok;
  }
  runHook(stdin, process.env, ctx.now);
  return EXIT.ok;
}
var ROUND_OUTCOMES = ["result", "question", "failed", "pass", "concerns", "fail", "skipped"];
var VERDICTS = new Set(["pass", "concerns", "fail", "skipped"]);
var OPEN_ATTENTION = new Set(["question", "concerns", "fail"]);
var ROUND_MODES = ["agent", "workflow", "cockpit"];
var records = (value) => Array.isArray(value) ? value.filter(isRecord5) : [];
function readJsonFile(ctx, file, flag) {
  const text2 = readIfExists2(resolve4(ctx.cwd, file));
  if (text2 === null)
    throw bad(`${flag} ${basename(file)} does not exist`);
  try {
    return JSON.parse(text2);
  } catch {
    throw bad(`${flag} ${basename(file)} is not valid JSON`);
  }
}
function planEntries(value, what) {
  if (value === undefined)
    return [];
  if (!Array.isArray(value))
    throw bad(`--plan: "${what}" must be a list`);
  return value.map((entry, i) => {
    const id = isRecord5(entry) ? isString(entry.task) ? entry.task : entry.id : undefined;
    if (!isRecord5(entry) || !isString(id) || !isString(entry.claim))
      throw bad(`--plan: ${what} ${i + 1} needs a task (or id) and a claim`);
    return { id, claim: entry.claim, reason: isString(entry.reason) ? entry.reason : "" };
  });
}
function roundPlan(data) {
  if (!isRecord5(data))
    throw bad("--plan must hold a JSON object");
  const closed = isRecord5(data.claims) && Array.isArray(data.claims.closed) ? data.claims.closed.filter(isString) : null;
  return {
    dispatch: planEntries(data.dispatch, "dispatch"),
    held: planEntries(data.held, "held"),
    width: typeof data.width === "number" ? data.width : null,
    closed
  };
}
function outcomesFromResult(data, into) {
  if (!isRecord5(data))
    throw bad("--result must hold a JSON object {results, questions, failed}");
  for (const q of records(data.questions)) {
    if (!isString(q.task) || q.task === "")
      continue;
    into.outcome.set(q.task, "question");
    if (isString(q.question))
      into.note.set(q.task, q.question);
    if (isString(q.builder))
      into.builder.set(q.task, q.builder);
  }
  for (const f of records(data.failed)) {
    if (!isString(f.task) || f.task === "")
      continue;
    into.outcome.set(f.task, "failed");
    if (isString(f.reason))
      into.note.set(f.task, f.reason);
    if (isString(f.builder))
      into.builder.set(f.task, f.builder);
  }
  for (const x of records(data.results)) {
    if (!isString(x.task) || x.task === "")
      continue;
    const task = x.task;
    if (isString(x.builder))
      into.builder.set(task, x.builder);
    if (isString(x.reader))
      into.reader.set(task, x.reader);
    if (typeof x.exit_code === "number" && x.exit_code !== 0) {
      into.outcome.set(task, "failed");
      into.note.set(task, `probe exit ${x.exit_code}${isString(x.probe_command) ? ` \u2014 ${x.probe_command}` : ""}`);
      continue;
    }
    const verdict = isRecord5(x.verdict) ? x.verdict : {};
    const v = verdict.verdict;
    into.outcome.set(task, isString(v) && VERDICTS.has(v) ? v : "result");
    const findings = records(verdict.findings);
    const worst = findings.find((f) => f.severity === "critical") ?? findings.find((f) => f.severity === "warning");
    if (worst !== undefined && isString(worst.issue))
      into.note.set(task, `${String(worst.severity)}: ${worst.issue}`);
    else if (isString(x.stub))
      into.note.set(task, x.stub);
  }
}
function pairs(args, name) {
  return (args.lists.get(name) ?? []).map((raw) => {
    const eq = raw.indexOf("=");
    if (eq <= 0)
      throw bad(`--${name} expects T<k>=<value>, got "${raw}"`);
    return [raw.slice(0, eq).trim(), raw.slice(eq + 1).trim()];
  });
}
function roundUnits(ref, claims) {
  const tasks = readIfExists2(join5(ref.dir, "tasks.md"));
  if (tasks === null) {
    const units2 = claims.filter((c) => !c.dropped).map((c) => ({ id: c.id, claim: c.id, lane: null, seam: false, parallel: false, text: c.text, paths: [], done: c.checked }));
    return { units: units2, hasTasks: false };
  }
  const units = parseTaskLines({ tasks }).tasks.filter((t) => t.state !== "struck").map((t) => ({
    id: t.id,
    claim: t.claim,
    lane: t.lane === "" ? null : t.lane,
    seam: t.flags.seam,
    parallel: t.flags.parallel,
    text: t.text,
    paths: [...t.paths],
    done: t.state === "done"
  }));
  return { units, hasTasks: true };
}
function roundsRecord(ctx, args) {
  const ref = specRef(ctx.root, required(args, 1, "the spec"));
  const doc = parseClaims(specText(ctx, ref));
  const mode = args.values.get("mode") ?? "agent";
  if (!ROUND_MODES.includes(mode))
    throw bad(`--mode "${mode}" is none of ${ROUND_MODES.join(", ")}`);
  const ts = args.values.get("ts") ?? ctx.now.toISOString();
  if (Number.isNaN(Date.parse(ts)))
    throw bad(`--ts "${ts}" is not a date`);
  const planFile = args.values.get("plan");
  const plan = planFile === undefined ? null : roundPlan(readJsonFile(ctx, planFile, "--plan"));
  const outcomes = { outcome: new Map, note: new Map, builder: new Map, reader: new Map };
  const resultFile = args.values.get("result");
  if (resultFile !== undefined)
    outcomesFromResult(readJsonFile(ctx, resultFile, "--result"), outcomes);
  for (const [task, o] of pairs(args, "outcome")) {
    if (!ROUND_OUTCOMES.includes(o))
      throw bad(`--outcome ${task}=${o}: expected one of ${ROUND_OUTCOMES.join(", ")}`);
    outcomes.outcome.set(task, o);
  }
  for (const [task, n] of pairs(args, "note"))
    outcomes.note.set(task, n.replace(/\s+/gu, " "));
  for (const [task, b] of pairs(args, "builder"))
    if (!outcomes.builder.has(task))
      outcomes.builder.set(task, b);
  for (const [task, r] of pairs(args, "reader"))
    if (!outcomes.reader.has(task))
      outcomes.reader.set(task, r);
  const { units, hasTasks } = roundUnits(ref, doc.claims);
  const logPath = join5(ref.dir, "rounds.jsonl");
  const existing = readIfExists2(logPath);
  const prev = roundLines(existing ?? undefined).at(-1);
  const prevById = new Map;
  for (const t of records(prev?.tasks))
    if (isString(t.id))
      prevById.set(t.id, t);
  const stubs = new Map;
  for (const v of doc.verification)
    if (!stubs.has(v.id))
      stubs.set(v.id, v.text);
  const closed = new Set(doc.claims.filter((c) => c.checked && !c.dropped).map((c) => c.id));
  const live = doc.claims.filter((c) => !c.dropped);
  const entries = [...plan?.dispatch ?? [], ...plan?.held ?? []];
  const key = (e) => hasTasks ? e.id : e.claim;
  const norm = (id) => hasTasks ? id : entries.find((e) => e.id === id)?.claim ?? id;
  const planned = new Map;
  for (const d of plan?.dispatch ?? [])
    planned.set(key(d), { reason: d.reason, dispatched: true });
  for (const h of plan?.held ?? [])
    planned.set(key(h), { reason: h.reason, dispatched: false });
  const normed = (m) => new Map([...m].map(([k, v]) => [norm(k), v]));
  const outcome = normed(outcomes.outcome);
  const note = normed(outcomes.note);
  const builderOf = normed(outcomes.builder);
  const readerOf = normed(outcomes.reader);
  const dispatched = new Set([...[...planned].filter(([, p]) => p.dispatched).map(([id]) => id), ...outcome.keys()]);
  const tasks = units.map((u) => {
    const base = { id: u.id, claim: u.claim, lane: u.lane, seam: u.seam, parallel: u.parallel, text: u.text, paths: [...u.paths], state: "held" };
    const p = planned.get(u.id);
    if (p !== undefined)
      base.reason = p.reason;
    const o = outcome.get(u.id);
    if (o !== undefined && VERDICTS.has(o))
      base.verdict = o;
    const n = note.get(u.id);
    if (n !== undefined)
      base.note = n;
    const b = builderOf.get(u.id);
    if (b !== undefined)
      base.builder = b;
    const r = readerOf.get(u.id);
    if (r !== undefined)
      base.reader = r;
    if (u.done) {
      base.state = closed.has(u.claim) ? "closed" : "done";
      const stub = stubs.get(u.claim);
      if (base.note === undefined && closed.has(u.claim) && stub !== undefined)
        base.note = stub;
      return base;
    }
    if (dispatched.has(u.id)) {
      if (o === "question")
        base.state = "question";
      else if (o === "failed" || o === "fail")
        base.state = "fail";
      else if (o === "concerns")
        base.state = "concerns";
      else if (o === "pass" || o === "skipped" || o === "result")
        base.state = closed.has(u.claim) ? "closed" : "done";
      else
        base.state = "dispatched";
      return base;
    }
    const was = prevById.get(u.id);
    if (was !== undefined && isString(was.state) && OPEN_ATTENTION.has(was.state)) {
      base.state = was.state;
      if (isString(was.verdict) && VERDICTS.has(was.verdict))
        base.verdict = was.verdict;
      if (base.note === undefined && isString(was.note))
        base.note = was.note;
      if (base.builder === undefined && isString(was.builder))
        base.builder = was.builder;
      if (base.reader === undefined && isString(was.reader))
        base.reader = was.reader;
      base.reason ??= "waiting \u2014 not dispatched again this round";
      return base;
    }
    base.reason ??= plan === null ? "not dispatched" : "not in this round's plan";
    return base;
  });
  const prevClaims = isRecord5(prev?.claims) && Array.isArray(prev.claims.closed) ? prev.claims.closed.filter(isString) : [];
  const before = new Set(plan?.closed ?? prevClaims);
  const stop = args.values.get("stop");
  const line = {
    v: 1,
    round: (typeof prev?.round === "number" ? prev.round : 0) + 1,
    ts,
    mode,
    width: plan?.width ?? null,
    dispatched: units.filter((u) => dispatched.has(u.id)).map((u) => u.id),
    tasks,
    claims: {
      closed: [...closed],
      open: live.filter((c) => !c.checked).map((c) => c.id),
      closed_this_round: [...closed].filter((c) => !before.has(c))
    },
    progress: `${closed.size}/${live.length}`,
    ...stop === undefined || stop === "" ? {} : { stop }
  };
  const lead = existing !== null && existing !== "" && !existing.endsWith(`
`) ? `
` : "";
  appendFileSync2(logPath, `${lead}${JSON.stringify(line)}
`);
  const landed = tasks.filter((t) => line.dispatched.includes(t.id)).map((t) => `${t.id} ${t.state}`);
  emit(ctx, args, { file: rel(ctx, logPath), line }, [
    `round ${line.round} \u2192 ${rel(ctx, logPath)} \xB7 dispatched ${landed.length === 0 ? "none" : landed.join(", ")} \xB7 progress ${line.progress}${stop === undefined ? "" : ` \xB7 stop: ${stop}`}`
  ]);
  return EXIT.ok;
}
function rounds(ctx, args) {
  const sub = required(args, 0, "record");
  if (sub !== "record")
    throw bad(`"${sub}" is no rounds command (record)`);
  return roundsRecord(ctx, args);
}
var gatePath = (ref, gate) => join5(ref.dir, ".gates", `${gate}.json`);
var numberOf = (ref) => specIdOf(ref.slug) ?? ref.slug;
var nextFor = (ref, gate) => gate === "reviewed" ? `/spec review ${numberOf(ref)}` : `/spec review ${numberOf(ref)} code`;
function checkedEvent(event) {
  const line = JSON.stringify(event);
  if (!validateEventLine(line).ok)
    throw bad(`the event line would be rejected: ${line}; nothing written`);
  return line;
}
function appendEventLine(dir, line) {
  const path = join5(dir, "events.jsonl");
  const existing = readIfExists2(path);
  const lead = existing !== null && existing !== "" && !existing.endsWith(`
`) ? `
` : "";
  appendFileSync2(path, `${lead}${line}
`);
}
function ensureGatesIgnored(ref) {
  const top = git(ref.dir, ["rev-parse", "--show-toplevel"])?.trim();
  if (top === undefined || top === "")
    return "no-git";
  const probe = relative(top, gatePath(ref, "reviewed")).split(sep2).join("/");
  if (git(top, ["-c", "core.fsmonitor=false", "check-ignore", "-q", "--", probe]) !== null)
    return "ignored";
  const path = join5(top, ".gitignore");
  const have = readIfExists2(path) ?? "";
  const lead = have === "" || have.endsWith(`
`) ? "" : `
`;
  appendFileSync2(path, `${lead}# Spec: gate marks stay on this machine
.gates/
`);
  return "added";
}
function treeEntry(root, path) {
  const absolute = join5(root, path);
  let stat2;
  try {
    stat2 = lstatSync(absolute);
  } catch (error) {
    if (error.code === "ENOENT")
      return null;
    throw error;
  }
  if (stat2.isSymbolicLink())
    return { path, mode: "120000", bytes: readlinkSync(absolute, { encoding: "buffer" }) };
  if (!stat2.isFile())
    return null;
  const mode = (stat2.mode & 64) === 0 ? "100644" : "100755";
  return { path, mode, bytes: readFileSync3(absolute) };
}
var listedPaths = (out) => [...new Set((out ?? "").split("\x00"))].filter((p) => p !== "" && !p.endsWith("/"));
function checkoutOf(cwd) {
  const root = git(cwd, ["rev-parse", "--show-toplevel"])?.trim();
  if (root === undefined || root === "")
    return null;
  const word = (out) => {
    const value = out?.trim() ?? "";
    return value === "" ? null : value;
  };
  const head = word(git(root, ["rev-parse", "--verify", "-q", "HEAD"]));
  const branch = word(git(root, ["rev-parse", "--abbrev-ref", "HEAD"]));
  const paths = git(root, ["-c", "core.fsmonitor=false", "ls-files", "-z", "--cached", "--others", "--exclude-standard"]);
  if (paths === null)
    return { root, tree: null, head, branch };
  return { root, tree: treeIdOf(listedPaths(paths).flatMap((p) => treeEntry(root, p) ?? [])), head, branch };
}
function changedSince(checkout, head) {
  const tracked = head === null ? null : git(checkout.root, ["-c", "core.fsmonitor=false", "diff", "--name-only", "-z", head, "--"]);
  const untracked = git(checkout.root, ["-c", "core.fsmonitor=false", "ls-files", "-z", "--others", "--exclude-standard"]);
  return [...new Set([...listedPaths(tracked), ...listedPaths(untracked)])].sort();
}
function gateCheckOf(ctx, ref, gate) {
  const text2 = readIfExists2(gatePath(ref, gate));
  const reading = text2 === null ? null : readGateMark(gate, text2);
  const problems = reading !== null && reading.mark === null ? reading.diagnostics.map((d) => d.message) : [];
  if (gate === "reviewed")
    return { check: reviewedGate(specFiles(ref).texts).check, problems };
  const checkout = checkoutOf(ctx.cwd);
  const check = gateState(gate, reading?.mark ?? null, { worktreeTree: checkout?.tree ?? null });
  if (check.state !== "stale")
    return { check, problems };
  if (checkout?.tree == null)
    return { check, problems: [...problems, "the tree id of the working tree could not be computed"] };
  const head = reading?.mark?.gate === "code-reviewed" ? reading.mark.head : null;
  return { check: { ...check, changed: changedSince(checkout, head) }, problems };
}
function gateCheck(ctx, args) {
  const gate = required(args, 1, "the gate (reviewed or code-reviewed)");
  if (gate !== "reviewed" && gate !== "code-reviewed")
    throw bad(`"${gate}" is no gate (reviewed, code-reviewed)`);
  const ref = specRef(ctx.root, required(args, 2, "the spec"));
  specText(ctx, ref);
  const { check, problems } = gateCheckOf(ctx, ref, gate);
  const next = check.state === "fresh" ? null : nextFor(ref, gate);
  const mark = rel(ctx, gatePath(ref, gate));
  let line;
  if (check.state === "fresh")
    line = `${ref.slug}: ${gate} mark fresh (${check.at ?? "no time"})`;
  else if (check.state === "missing")
    line = `${ref.slug}: not ${gate}, no readable ${mark}${problems.length > 0 ? ` (${problems.join("; ")})` : ""}`;
  else {
    const why = check.changed.length > 0 ? `changed since: ${check.changed.join(", ")}` : problems.join("; ") || "the working tree changed";
    line = `${ref.slug}: the ${gate} mark is stale, ${why}`;
  }
  emit(ctx, args, { spec: ref.slug, gate, state: check.state, at: check.at, changed: check.changed, problems, next }, next === null ? [line] : [line, `next: ${next}`]);
  return check.state === "fresh" ? EXIT.ok : EXIT.drift;
}
var needsYes = (ctx, ref, gate) => bad(`gate ${gate} needs --yes: it writes ${rel(ctx, gatePath(ref, gate))} and appends to events.jsonl; nothing written`);
function gateReviewed(ctx, args, ref) {
  if (!args.flags.has("yes"))
    throw needsYes(ctx, ref, "reviewed");
  specText(ctx, ref);
  const texts = specFiles(ref).texts;
  const textOf2 = { "spec.md": texts.spec, "plan.md": texts.plan, "tasks.md": texts.tasks };
  const files = {};
  for (const f of REVIEWED_FILES) {
    const text2 = textOf2[f];
    files[f] = text2 === undefined ? null : hashForGate(f, text2);
  }
  const at = ctx.now.toISOString();
  const event = { ts: at, from: "review", to: "build", command: args.values.get("command") ?? nextFor(ref, "reviewed"), actor: args.values.get("actor") ?? CLI_SESSION };
  const line = checkedEvent(event);
  const mark = reviewedMarkText(at, files);
  const gitignore = ensureGatesIgnored(ref);
  mkdirSync3(join5(ref.dir, ".gates"), { recursive: true });
  writeFileSync2(gatePath(ref, "reviewed"), mark);
  appendEventLine(ref.dir, line);
  const ignored = gitignore === "added" ? "; .gitignore: added .gates/" : "";
  emit(ctx, args, { spec: ref.slug, gate: "reviewed", at, files, event, gitignore }, [
    `${ref.slug}: reviewed (${rel(ctx, gatePath(ref, "reviewed"))}); review \u2192 build (${event.command})${ignored}`
  ]);
  return EXIT.ok;
}
function countValue(args, name) {
  const raw = requiredValue(args, name, "N (the accepted open findings)");
  if (!/^\d+$/u.test(raw))
    throw bad(`--${name} "${raw}" is no non-negative integer`);
  return Number(raw);
}
async function gateCodeReviewed(ctx, args, ref) {
  if (!args.flags.has("yes"))
    throw needsYes(ctx, ref, "code-reviewed");
  const code = countValue(args, "code");
  const security = countValue(args, "security");
  specText(ctx, ref);
  if (checkoutOf(ctx.cwd) === null)
    throw bad("not inside a git checkout: a code-reviewed mark names a git tree; nothing written");
  const at = ctx.now.toISOString();
  const actor = args.values.get("actor") ?? CLI_SESSION;
  const row = buildDashboard(dashboardInput(ctx, await locksOf(ctx))).specs.find((r) => r.slug === ref.slug);
  const eventsText = specFiles(ref).texts.events;
  const inClose = eventsText !== undefined && parseEvents(eventsText).events.at(-1)?.to === "close";
  const event = row?.stage === "code-review" && !inClose ? { ts: at, from: "code-review", to: "close", command: args.values.get("command") ?? nextFor(ref, "code-reviewed"), actor } : null;
  const line = event === null ? null : checkedEvent(event);
  const gitignore = ensureGatesIgnored(ref);
  if (line !== null)
    appendEventLine(ref.dir, line);
  const checkout = checkoutOf(ctx.cwd);
  if (checkout?.tree == null)
    throw bad(`the tree id of the working tree could not be computed${line === null ? "" : " after the event line was appended"}; no mark written`);
  const note = args.values.get("note");
  const mark = codeReviewedMarkText({ at, actor, tree: checkout.tree, head: checkout.head, branch: checkout.branch, code, security, ...note === undefined ? {} : { note } });
  mkdirSync3(join5(ref.dir, ".gates"), { recursive: true });
  writeFileSync2(gatePath(ref, "code-reviewed"), mark);
  const on = checkout.branch === null ? "" : ` on ${checkout.branch}`;
  const moved = event === null ? "" : "; code-review \u2192 close";
  const ignored = gitignore === "added" ? "; .gitignore: added .gates/" : "";
  emit(ctx, args, { spec: ref.slug, gate: "code-reviewed", at, tree: checkout.tree, head: checkout.head, branch: checkout.branch, code, security, event, gitignore }, [
    `${ref.slug}: code-reviewed at tree ${checkout.tree.slice(0, 12)}${on} (code ${code}, security ${security})${moved}${ignored}`
  ]);
  return EXIT.ok;
}
async function gateCommand(ctx, args) {
  const sub = required(args, 0, "check, reviewed or code-reviewed");
  if (sub === "check")
    return gateCheck(ctx, args);
  if (sub !== "reviewed" && sub !== "code-reviewed")
    throw bad(`"${sub}" is neither check, reviewed nor code-reviewed`);
  const ref = specRef(ctx.root, required(args, 1, "the spec"));
  if (ref.archived)
    throw bad(`${rel(ctx, ref.dir)} is archived; nothing written`);
  return sub === "reviewed" ? gateReviewed(ctx, args, ref) : gateCodeReviewed(ctx, args, ref);
}
function pickFolder(pool, arg) {
  const name = basename(arg.replace(/[\\/]+$/u, ""));
  return pool.find((s) => s.id === name || s.slug === name || specSlugOf(s.slug) === name);
}
function shiftedText(text2, down) {
  const fm = parseFrontmatter(text2);
  const lines = text2.split(`
`);
  const shift = (path) => down ? `../${path}` : path.replace(/^\.\.\//u, "");
  if (fm.present) {
    for (const [key, line] of Object.entries(fm.keyLines)) {
      if (!(fm.values[key] ?? "").startsWith("../"))
        continue;
      lines[line - 1] = (lines[line - 1] ?? "").replace(/^([\w-]+:\s*["']?)(\.\.\/)/u, (_m, head, up) => `${head}${shift(up)}`);
    }
  }
  for (let i = fm.present ? fm.bodyLine - 1 : 0;i < lines.length; i++) {
    lines[i] = (lines[i] ?? "").replace(/\]\((\.\.\/[^)\s]*)/gu, (_m, path) => `](${shift(path)}`);
  }
  return lines.join(`
`);
}
function stampedText(spec, date, reason) {
  const fm = parseFrontmatter(spec);
  if (!fm.present)
    return date === null ? spec : null;
  const lines = spec.split(`
`);
  const close = fm.bodyLine - 2;
  const cr = (lines[close] ?? "").endsWith("\r") ? "\r" : "";
  const keep = lines.slice(1, close).filter((line) => !/^archived(?:_reason)?:/u.test(line));
  const added = date === null ? [] : [`archived: ${date}${cr}`, ...reason === null ? [] : [`archived_reason: ${JSON.stringify(reason)}${cr}`]];
  const out = [lines[0] ?? "", ...keep, ...added, ...lines.slice(close)].join(`
`);
  const back = parseFrontmatter(out);
  return back.data.archived === date && back.data.archivedReason === (date === null ? null : reason) && back.body === fm.body ? out : null;
}
function plannedTexts(ctx, ref, down, date, reason) {
  const texts = new Map;
  for (const name of readdirSync3(ref.dir).filter((n) => n.endsWith(".md"))) {
    const before = readFileSync3(join5(ref.dir, name), "utf8");
    let after = shiftedText(before, down);
    if (name === "spec.md")
      after = stampedText(after, date, reason);
    if (after === null)
      throw bad(`${rel(ctx, ref.dir)}/spec.md: the archive stamp does not read back; nothing moved`);
    if (after !== before)
      texts.set(name, after);
  }
  return texts;
}
function archiveBlockers(text2, ref, listed2, master, locks) {
  const blockers = [];
  const fm = parseFrontmatter(text2);
  const spec = parseClaims(text2);
  const heldElsewhere2 = new Set(listed2.filter((s) => s.slug !== ref.slug).flatMap((s) => [...idsOf(readIfExists2(join5(s.dir, "spec.md")))]));
  const report = driftReport({ frontmatter: fm, spec, master: master === null ? null : parseClaims(master), heldElsewhere: heldElsewhere2 });
  if (hasDrift(report))
    blockers.push({ kind: "drift", hard: true, detail: `drift against the master: run spec-check drift ${ref.id} and repair it first` });
  const ids = new Set(spec.claims.map((c) => c.id));
  const held = locks.locks.filter((l) => ids.has(l.claim));
  if (held.length > 0)
    blockers.push({ kind: "lock", hard: true, detail: `live claim lock on ${[...new Set(held.map((l) => `${l.claim} (${l.session})`))].join(", ")}` });
  if (fm.data.phase !== "complete")
    blockers.push({ kind: "phase", hard: false, detail: `phase is ${fm.data.phase ?? "unset"}, not complete` });
  const open = spec.counted.total - spec.counted.closed;
  if (open > 0)
    blockers.push({ kind: "open-claims", hard: false, detail: `${open} claim${open === 1 ? "" : "s"} still open` });
  return blockers;
}
function archiveReferences(ctx, slug) {
  const needle = new RegExp(`(?<!archive/)specs/${slug.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&")}(?![\\w-])`, "u");
  const out = [];
  const add = (file, line, text2) => {
    if (needle.test(text2))
      out.push({ file, line, text: text2.trim().slice(0, 160) });
  };
  (readIfExists2(masterPath(ctx)) ?? "").split(`
`).forEach((text2, i) => add("ISA.md", i + 1, text2));
  const grep = git(ctx.root, ["grep", "-n", "-I", "-F", "-e", `specs/${slug}`, "--", ".", ":!specs", ":!ISA.md"]) ?? "";
  for (const hit of grep.split(`
`)) {
    const m = /^([^:]+):(\d+):(.*)$/u.exec(hit);
    if (m)
      add(m[1] ?? "", Number(m[2]), m[3] ?? "");
  }
  return out;
}
function performMove(ctx, move) {
  mkdirSync3(dirname2(join5(ctx.root, move.to)), { recursive: true });
  const tracked = (git(ctx.root, ["ls-files", "--", move.from]) ?? "").trim() !== "";
  if (tracked) {
    if (git(ctx.root, ["mv", move.from, move.to]) === null)
      throw bad(`git mv ${move.from} ${move.to} failed`);
  } else {
    renameSync2(join5(ctx.root, move.from), join5(ctx.root, move.to));
  }
  for (const [name, text2] of move.texts)
    writeFileSync2(join5(ctx.root, move.to, name), text2);
}
async function archive(ctx, args) {
  const restore = args.positional[0] === "restore";
  const targets = args.positional.slice(restore ? 1 : 0);
  if (targets.length === 0)
    throw bad(restore ? "archive restore needs at least one NNN" : "archive needs at least one NNN");
  const dry = args.flags.has("dry-run");
  const reason = args.values.get("reason") ?? null;
  if (reason !== null && (reason.trim() === "" || /[\r\n]/u.test(reason)))
    throw bad("--reason needs one line of text");
  if (restore && reason !== null)
    throw bad("archive restore takes no --reason");
  const listed2 = listSpecs(ctx.root);
  const active = listed2.filter((s) => !s.archived);
  const archived = listed2.filter((s) => s.archived);
  const pool = restore ? archived : active;
  const refs2 = [];
  for (const target of targets) {
    const hit = pickFolder(pool, target);
    if (hit === undefined) {
      const other = pickFolder(restore ? active : archived, target);
      throw bad(`no ${restore ? "archived" : "active"} spec ${target}${other === undefined ? "" : `: ${rel(ctx, other.dir)} is ${restore ? "active" : "already archived"}`}`);
    }
    if (restore && active.some((s) => s.id === hit.id))
      throw bad(`an active folder holds ${hit.id} already; restoring ${hit.slug} would collide`);
    if (!refs2.includes(hit))
      refs2.push(hit);
  }
  if (restore)
    return archiveRestore(ctx, args, refs2, dry);
  const master = readIfExists2(masterPath(ctx));
  const locks = await locksOf(ctx);
  const verdicts = refs2.map((ref) => {
    const blockers = archiveBlockers(specText(ctx, ref), ref, listed2, master, locks);
    const ok = blockers.every((b) => !b.hard) && (blockers.length === 0 || reason !== null);
    return { spec: ref.slug, from: rel(ctx, ref.dir), to: `specs/archive/${ref.slug}`, ok, blockers, ref };
  });
  const verdictLines = verdicts.flatMap((v) => [
    `${v.spec}  ${v.ok ? v.blockers.length === 0 ? "ok" : "ok with --reason" : "blocked"}`,
    ...v.blockers.map((b) => `    ${b.hard ? "hard" : "soft"}: ${b.detail}${b.hard ? "" : " (--reason lifts it)"}`)
  ]);
  const verdictView = verdicts.map((v) => ({ spec: v.spec, from: v.from, to: v.to, ok: v.ok, blockers: v.blockers }));
  const refused = verdicts.filter((v) => !v.ok);
  if (refused.length > 0) {
    emit(ctx, args, { dryRun: dry, reason, moved: false, verdicts: verdictView }, [
      ...verdictLines,
      `nothing moved: ${refused.length} spec${refused.length === 1 ? "" : "s"} blocked`
    ]);
    return EXIT.drift;
  }
  const date = ctx.now.toISOString().slice(0, 10);
  const moves = verdicts.map((v) => {
    const why = v.blockers.length === 0 ? null : reason;
    return { move: { ref: v.ref, from: v.from, to: v.to, texts: plannedTexts(ctx, v.ref, true, date, why) }, reason: why };
  });
  const report = moves.map(({ move, reason: why }) => {
    if (!dry)
      performMove(ctx, move);
    return { spec: move.ref.slug, from: move.from, to: move.to, reason: why, references: archiveReferences(ctx, move.ref.slug) };
  });
  const lines = [
    ...verdictLines,
    ...report.flatMap((r) => [
      `${dry ? "would archive" : "archived"} ${r.from} \u2192 ${r.to}${r.reason === null ? "" : ` (reason: ${r.reason})`}`,
      ...r.references.map((x) => `    reference left: ${x.file}:${x.line}  ${x.text}`)
    ]),
    ...report.some((r) => r.references.length > 0) ? ["references outside specs/ are reported, never edited"] : []
  ];
  emit(ctx, args, { dryRun: dry, reason, moved: !dry, verdicts: verdictView, archived: report }, lines);
  return EXIT.ok;
}
function archiveRestore(ctx, args, refs2, dry) {
  const rows = listArchive(refs2.map(specFiles));
  const moves = refs2.map((ref) => ({ ref, from: rel(ctx, ref.dir), to: `specs/${ref.slug}`, texts: plannedTexts(ctx, ref, false, null, null) }));
  for (const move of moves)
    if (!dry)
      performMove(ctx, move);
  const restored = moves.map((m) => {
    const row = rows.find((r) => r.slug === m.ref.slug);
    return { spec: m.ref.slug, from: m.from, to: m.to, archived: row?.archived ?? null, archivedReason: row?.archivedReason ?? null };
  });
  emit(ctx, args, { dryRun: dry, restored }, restored.map((r) => `${dry ? "would restore" : "restored"} ${r.from} \u2192 ${r.to}${r.archived === null ? "" : ` (archived ${r.archived}${r.archivedReason === null ? "" : `: ${r.archivedReason}`})`}`));
  return EXIT.ok;
}
var COMMANDS = {
