  gate: {
    usage: 'gate check reviewed|code-reviewed <spec> [--json] | gate reviewed <spec> --yes [--actor <actor>] [--command "<\u2026>"] [--json] | gate code-reviewed <spec> --yes --code N --security N [--note "<\u2026>"] [--actor <actor>] [--json]',
    summary: "check a gate mark (exit 0 fresh; 3 missing or stale, with the changed files and the next step) or set one: reviewed writes .gates/reviewed.json and one review \u2192 build line in events.jsonl; code-reviewed writes the per-spec .gates/code-reviewed.json over the tree id of the checkout, one code-review \u2192 close line first when the spec stands in code-review. Without --yes nothing is written, exit 1",
