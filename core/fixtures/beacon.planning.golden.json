  "features": [
    {
      "id": "F1",
      "name": "Check scheduling",
      "why": "checks run on time and an outage is never recorded twice.",
      "rank": 1,
      "priority": "P3",
      "closed": 5,
      "total": 5,
      "claims": [
        {
          "id": "ISC-1",
          "text": "A check runs at the interval its definition names, within one second.",
          "closed": true,
          "dropped": false,
          "holder": "001"
        },
        {
          "id": "ISC-2",
          "text": "A check that times out is recorded as down, never as up.",
          "closed": true,
          "dropped": false,
          "holder": "001"
        },
        {
          "id": "ISC-3",
          "text": "Two checks on one host never run at the same instant.",
          "closed": true,
          "dropped": false,
          "holder": "001"
        },
        {
          "id": "ISC-20",
          "text": "A failed run is retried with exponential backoff up to three times.",
          "closed": true,
          "dropped": false,
          "holder": "006"
        },
        {
          "id": "ISC-21",
          "text": "a retry is counted as a separate outage.",
          "closed": true,
          "dropped": false,
          "holder": "006"
        }
      ],
