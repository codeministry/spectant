# the master holds the German goal verbatim and names private repositories (ISA Decisions 2026-09-28)
ISA.md

# derived by the old Spec skill; the app replaces them
specs/**/*.html
specs/**/*.version.js
specs/**/.vendor/
specs/**/.i18n/
specs/**/.design/
specs/**/.evidence/

# agent activity, written by the plugin hooks
.spectant/

node_modules/
dist/

# Spec: translations, derived pages and gate marks never leave this machine (SpecTranslate.ts)
specs/*/.gates/

# derived by the old Spec skill for its badge switcher
specs/specs.js

# agent worktrees
.claude/worktrees/

# per-round build log and gate marks, derived by the Spec skill
specs/*/rounds.jsonl
specs/*/.gates/

# generated at build time by scripts/embed.ts from the web output (T6 seam)
server/embedded.gen.ts

# Angular CLI cache
.angular/

# TL;DR in German for the principal, written by /spec-tldr (public repo keeps specs/ English)
specs/tldr.md

# German working notes for the principal (public repo keeps specs/ English)
specs/notes/notizen.md

# Playwright output (web/e2e/playwright.config.ts)
web/e2e/.report/
web/e2e/.results/

# LifeOS checkpoint state written beside the repository by the spec tooling; never part of the tree.
.checkpoint-state.json

# archify diagrams, generated locally with repository evidence; never part of the tree.
.archify/

# Outline export in German for the principal (public repo keeps specs/ English)
specs/notes/outline.md

# planning is private: specs/ (constitution, ideas, every spec) stays on this machine and out of the public tree (principal, 2026-10-11)
/specs/
# a spec worktree links `specs` to the main checkout's folder (symlink); a directory pattern never matches a link
/specs
