{
  "name": "spectant",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  },
  "workspaces": [
    "core",
    "server",
    "web"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"web/src/**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd web typecheck",
    "check:static": "bun run lint && bun run lint:css && bun run typecheck && bun run check:format-doc",
    "verify:quick": "bun run check:static && bun test",
    "verify": "bun run verify:quick && bun run test:browser && bun run e2e && bun run test:visual && bun run build",
    "check:leak": "bun scripts/check-leak.ts",
    "check:format-doc": "bun scripts/check-format-doc.ts",
    "check:single-core": "bun scripts/check-single-core.ts",
    "check:version": "bun scripts/check-version.ts",
    "test:binary": "bun scripts/build.ts --host-only && SPECTANT_TEST_BINARY=1 bun test tests/binary.test.ts",
    "test:install:linux": "bun tests/install/run.ts",
    "test:readonly": "bun test tests/readonly.test.ts",
    "test:offline:server": "bun tests/offline-server.ts",
    "test:visual": "bun run --cwd web test:visual",
    "test:visual:ci": "bun web/e2e/container.ts visual",
    "test:browser": "bun run --cwd web test:browser",
    "e2e": "bun run --cwd web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "angular-eslint": "22.5.0",
    "bun-types": "1.3.12",
    "eslint": "9.39.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
